var LocalSyncBackend = class {
  cfg;
  constructor(cfg) {
    this.cfg = cfg;
  }
  resolveIdentity(token) {
    return Promise.resolve(this.cfg.memberships[token] ?? null);
  }
  remoteAccess(teamId) {
    return Promise.resolve({ url: (0, import_node_path3.join)(this.cfg.reposDir, `${teamId}.git`), env: {} });
  }
};
var HttpSyncBackend = class {
  cfg;
  constructor(cfg) {
    this.cfg = cfg;
  }
  async resolveIdentity(token) {
    const res = await fetch(this.endpoint("/git/identity"), {
      headers: { authorization: `Bearer ${token}` }
    });
    if (!res.ok)
      return null;
    const body = await res.json();
    return {
      userId: body.userId,
      teamId: body.teamId,
      role: body.role,
      // Absent on an older API — carried through as undefined rather than defaulted here, so the
      // cache never records a guess as if the server had said it.
      ...body.teamName ? { teamName: body.teamName } : {},
      ...body.shape ? { shape: body.shape } : {}
    };
  }
  /** Append a path to the API base, preserving any base path prefix (mirrors {@link remoteAccess}). */
  endpoint(path) {
    const url = new URL(this.cfg.apiBaseUrl);
    url.pathname = `${url.pathname.replace(/\/$/, "")}${path}`;
    return url;
  }
  async remoteAccess(teamId) {
    const binding = await readBinding(teamId, this.cfg.configHome, this.cfg.dataHome);
    if (!binding)
      throw notLoggedIn(teamId, this.cfg.configHome);
    const url = this.endpoint(`/git/${teamId}`).toString();
    return { url, env: authHeaderEnv(url, binding.token) };
  }
  /** `GET /wiki/charter` with the stored device token. Fail-open: any failure → `null`. */
  async fetchCharter(teamId) {
    try {
      const binding = await readBinding(teamId, this.cfg.configHome, this.cfg.dataHome);
      if (!binding)
        return null;
      const res = await fetch(this.endpoint("/wiki/charter"), {
        headers: { authorization: `Bearer ${binding.token}` }
      });
      if (!res.ok)
        return null;
      const body = await res.json();
      if (!body.chartered)
        return null;
      return {
        audience: body.audience ?? null,
        retrievalBrief: body.retrievalBrief ?? null,
        excludes: body.excludes ?? null
      };
    } catch {
      return null;
    }
  }
};

