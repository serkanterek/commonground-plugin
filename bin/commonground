function templateFor(shape) {
  return COVERAGE_TEMPLATES[shape] ?? COVERAGE_TEMPLATES.company;
}
var STUB_SUMMARY_RE = /^(?:tbd|todo|wip|tba|n\/a|na|xxx+|\.{2,}|…|[-—–]+|\?+)$/i;
var MIN_SUMMARY_CHARS = 2;
function hasSubstance(e) {
  if (e.scope === "(unparseable)")
    return false;
  const s = (e.summary || "").trim();
  return s.length >= MIN_SUMMARY_CHARS && !STUB_SUMMARY_RE.test(s);
}
var LABEL_STOPWORDS = /* @__PURE__ */ new Set(["and", "the", "for", "our", "your", "with", "from", "etc"]);
function labelTokens(label) {
  const out = [];
  for (const m of label.toLowerCase().matchAll(/[a-z0-9]+/g)) {
    const w = m[0];
    if (w.length >= 3 && !LABEL_STOPWORDS.has(w) && !/^\d+$/.test(w))
      out.push(w);
  }
  return out;
}
function sectionsFromCharter(sections) {
  const seenIds = /* @__PURE__ */ new Set();
  return sections.map((sec, i) => {
    const slug = sec.label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
    let id = slug || `section-${i + 1}`;
    while (seenIds.has(id))
      id = `${id}-${i + 1}`;
    seenIds.add(id);
    const intent = /\b(decision|adr|convention)/i.test(`${sec.label} ${sec.hint}`) ? "decision" : "ingest";
    const phrase = sec.label.toLowerCase().replace(/\s+/g, " ").trim();
    const words = [phrase, ...labelTokens(sec.label)];
    const match = intent === "decision" ? either(typ("decision"), kw(...words)) : kw(...words);
    return {
      id,
      label: sec.label,
      icon: intent === "decision" ? "gavel" : "file-text",
      target: 1,
      intent,
      hint: sec.hint,
      match,
      prompt: sec.hint ? `Add a page for "${sec.label}" \u2014 ${sec.hint}.` : `Add a page for "${sec.label}".`,
      placeholder: ""
    };
  });
}
var DISCIPLINE_BY_SECTION = {
  about: "other",
  clients: "pm",
  decisions: "dev",
  stack: "dev",
  overview: "pm",
  roadmap: "pm",
  personas: "pm",
  mission: "exec",
  ways: "pm",
  glossary: "other",
  values: "exec",
  products: "pm",
  teams: "exec"
};
function excludeMatcher(excludes) {
  const text = (excludes ?? "").toLowerCase();
  if (!text.trim())
    return () => false;
  return (label) => {
    const tokens = labelTokens(label);
    return tokens.length > 0 && tokens.some((token) => text.includes(token));
  };
}
function computeCoverage(entries, shape, teamName, charter) {
  const idx = (Array.isArray(entries) ? entries : []).filter((e) => e.pageId !== CHARTER_PAGE_ID && hasSubstance(e));
  const defaultScope = shapeDefaultScope(shape || "company", teamName || "team");
  const template = charter?.sections?.length ? sectionsFromCharter(charter.sections) : templateFor(shape);
  const isExcluded = excludeMatcher(charter?.excludes ?? null);
  return template.map((sec) => {
    const have = idx.filter(sec.match);
    const count = have.length;
    const excluded = count === 0 && isExcluded(sec.label);
    const status2 = excluded ? "excluded" : count === 0 ? "empty" : count >= sec.target ? "done" : "partial";
    return {
      id: sec.id,
      label: sec.label,
      icon: sec.icon,
      hint: sec.hint,
      target: sec.target,
      intent: sec.intent,
      prompt: sec.prompt,
      placeholder: sec.placeholder,
      discipline: DISCIPLINE_BY_SECTION[sec.id] ?? "other",
      scope: defaultScope,
      have,
      count,
      status: status2,
      ...excluded ? { excludedBy: (charter?.excludes ?? "").trim() } : {}
    };
  });
}

// ../core/dist/wiki/page-serde.js
var import_yaml = __toESM(require_dist(), 1);
var PageParseError = class extends Error {
  constructor(message) {
    super(message);
    this.name = "PageParseError";
  }
};
var FRONTMATTER_FENCE = /^---\r?\n([\s\S]*?)\r?\n---[ \t]*\r?\n?/;
function orderedFrontmatter(fm) {
  const out = { title: fm.title };
  if (fm.summary !== void 0)
    out.summary = fm.summary;
  out.type = fm.type;
  out.scope = fm.scope;
  if (fm.section !== void 0)
    out.section = fm.section;
  if (fm.owner !== void 0)
    out.owner = fm.owner;
  out.status = fm.status;
  if (fm.created !== void 0)
    out.created = fm.created;
  out.updated = fm.updated;
  if (fm.aliases !== void 0)
    out.aliases = fm.aliases;
  if (fm.tags !== void 0)
    out.tags = fm.tags;
  out.sources = fm.sources;
  out.related = fm.related;
  for (const key of Object.keys(fm.extra ?? {}).sort()) {
    if (key === "__proto__" || key === "constructor" || key === "prototype")
      continue;
    const value = fm.extra[key];
    if (value !== void 0)
      Object.defineProperty(out, key, { value, enumerable: true, writable: true, configurable: true });
  }
  return out;
}
function normalizeBody(body) {
  return body.replace(/^\s*\n/, "").trimEnd();
}
function serializePage(frontmatter, body) {
  const yaml = (0, import_yaml.stringify)(orderedFrontmatter(frontmatter)).trimEnd();
  const trimmedBody = normalizeBody(body);
  return trimmedBody.length > 0 ? `---
${yaml}
---

${trimmedBody}
` : `---
${yaml}
---
`;
}
function parsePage(raw) {
  const match = FRONTMATTER_FENCE.exec(raw);
  if (!match)
    throw new PageParseError("missing frontmatter block");
  let parsed;
  try {
    parsed = (0, import_yaml.parse)(match[1]);
  } catch {
    throw new PageParseError("invalid YAML frontmatter");
  }
  const result = validateFrontmatter(parsed);
  if (!result.ok)
    throw new PageParseError(`invalid frontmatter: ${result.errors.join("; ")}`);
  return { frontmatter: result.value, body: normalizeBody(raw.slice(match[0].length)) };
}
function deriveSummary(body, max = 140) {
  for (const line of body.split("\n")) {
    const text = line.trim();
    if (!text || text.startsWith("#"))
      continue;
    if (text.length <= max)
      return text;
    let cut = max - 1;
    const last = text.charCodeAt(cut - 1);
    if (last >= 55296 && last <= 56319)
      cut -= 1;
    return `${text.slice(0, cut).trimEnd()}\u2026`;
  }
  return "";
}

// ../core/dist/wiki/index-regen.js
var LEVEL_RANK = { company: 0, department: 1, team: 2, product: 3 };
function levelRank(scope) {
  const level = scope.split(":", 1)[0];
  return LEVEL_RANK[level] ?? 99;
}
function compareCodeUnits(a, b) {
  return a < b ? -1 : a > b ? 1 : 0;
}
function compareEntries(a, b) {
  return levelRank(a.scope) - levelRank(b.scope) || compareCodeUnits(a.scope, b.scope) || compareCodeUnits(a.pageId, b.pageId);
}
function scopeDir(scope) {
  const parsed = parseScope(scope);
  if (!parsed)
    return null;
  const dir = SCOPE_DIRS[parsed.level];
  return parsed.key ? `${dir}/${parsed.key}` : dir;
}
function subgroupOf(entry) {
  const dir = scopeDir(entry.scope);
  const rest = dir && entry.pageId.startsWith(`${dir}/`) ? entry.pageId.slice(dir.length + 1) : entry.pageId;
  const cut = rest.indexOf("/");
  return cut > 0 ? rest.slice(0, cut) : null;
}
function regenerateIndex(entries) {
  const lines = ["# Wiki catalog", ""];
  if (entries.length === 0) {
    lines.push("_No pages yet._", "");
    return lines.join("\n");
  }
  const sorted = [...entries].sort(compareEntries);
  const multiScope = new Set(sorted.map((e) => e.scope)).size > 1;
  const subHeading = multiScope ? "###" : "##";
  let scope = null;
  for (let i = 0; i < sorted.length; ) {
    scope = sorted[i].scope;
    const inScope = [];
    while (i < sorted.length && sorted[i].scope === scope)
      inScope.push(sorted[i++]);
    if (multiScope)
      lines.push(`## ${scope}`, "");
    const grouped = /* @__PURE__ */ new Map();
    for (const entry of inScope) {
      const group = subgroupOf(entry);
      if (group === null) {
        lines.push(buildIndexLine(entry));
        continue;
      }
      let bucket = grouped.get(group);
      if (!bucket)
        grouped.set(group, bucket = []);
      bucket.push(entry);
    }
    if (grouped.size > 0 && lines[lines.length - 1] !== "")
      lines.push("");
    for (const [group, groupEntries] of grouped) {
      lines.push(`${subHeading} ${group}`, "");
      for (const entry of groupEntries)
        lines.push(buildIndexLine(entry));
      lines.push("");
    }
    if (lines[lines.length - 1] !== "")
      lines.push("");
  }
  return lines.join("\n");
}

// ../core/dist/wiki/wiki.js
var RESERVED_FIRST_SEGMENTS = /* @__PURE__ */ new Set([".git", WIKI_LAYOUT.configDir]);
var RESERVED_PAGE_IDS = /* @__PURE__ */ new Set([
  pageIdFromPath(WIKI_LAYOUT.indexFile),
  pageIdFromPath(WIKI_LAYOUT.logFile)
]);
function toIndexEntry(p) {
  const entry = {
    pageId: p.pageId,
    title: p.frontmatter.title,
    type: p.frontmatter.type,
    scope: p.frontmatter.scope,
    summary: p.frontmatter.summary ?? deriveSummary(p.body),
    updated: p.frontmatter.updated
  };
  if (p.frontmatter.section !== void 0)
    entry.section = p.frontmatter.section;
  return entry;
}

// ../core/dist/wiki/import-normalize.js
var import_yaml2 = __toESM(require_dist(), 1);
var FRONTMATTER_FENCE2 = /^---\r?\n([\s\S]*?)\r?\n---[ \t]*\r?\n?/;
function firstH1(body) {
  for (const line of body.split("\n")) {
    const m = /^#[ \t]+(.+?)[ \t]*$/.exec(line);
    if (m)
      return m[1];
  }
  return void 0;
}
function titleFromStem(relPath) {
  const base = relPath.split(/[/\\]/).pop() ?? relPath;
  const stem = base.replace(/\.md$/i, "");
  return stem.split(/[-_\s]+/).filter(Boolean).map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
}
function isRecord2(v) {
  return typeof v === "object" && v !== null && !Array.isArray(v);
}
function splitFrontmatter(content) {
  const m = FRONTMATTER_FENCE2.exec(content);
  if (m) {
    try {
      const parsed = (0, import_yaml2.parse)(m[1]);
      if (isRecord2(parsed))
        return { old: parsed, body: content.slice(m[0].length) };
    } catch {
    }
  }
  return { old: {}, body: content };
}
function stringArray(v) {
  if (typeof v === "string")
    return [v];
  return Array.isArray(v) && v.every((s) => typeof s === "string") ? v : void 0;
}
function isDateString(v) {
  return FrontmatterSchema.shape.updated.safeParse(v).success;
}
function resolveUpdated(old, mtime, today) {
  if (isDateString(old))
    return old;
  if (isDateString(mtime))
    return mtime;
  return today;
}
function backfill(file, opts) {
  const { old, body } = splitFrontmatter(file.content);
  const loss = { dropped: [], replaced: [] };
  const replaced = (key, from, to) => {
    if (from !== void 0 && from !== to)
      loss.replaced.push(`${key}: ${JSON.stringify(from)} \u2192 ${to}`);
  };
  const title = typeof old.title === "string" && old.title.trim().length > 0 ? old.title : firstH1(body) ?? titleFromStem(file.relPath);
  replaced("title", old.title, title);
  const type = typeof old.type === "string" && PAGE_TYPES.includes(old.type) ? old.type : "concept";
  replaced("type", old.type, type);
  const scope = typeof old.scope === "string" && parseScope(old.scope) !== null ? old.scope : opts.defaultScope;
  replaced("scope", old.scope, scope);
  const status2 = typeof old.status === "string" && PAGE_STATUSES.includes(old.status) ? old.status : "active";
  replaced("status", old.status, status2);
  const updated = resolveUpdated(old.updated, file.mtime, opts.today);
  replaced("updated", old.updated, updated);
  const fm = { title, type, scope, status: status2, updated };
  if (typeof old.section === "string" && SCOPE_SECTIONS.includes(old.section)) {
    fm.section = old.section;
  } else if (old.section !== void 0)
    loss.dropped.push("section");
  if (typeof old.owner === "string" && old.owner.length > 0)
    fm.owner = old.owner;
  else if (old.owner !== void 0)
    loss.dropped.push("owner");
  if (typeof old.summary === "string" && old.summary.trim().length > 0)
    fm.summary = old.summary;
  else if (old.summary !== void 0)
    loss.dropped.push("summary");
  if (isDateString(old.created))
    fm.created = old.created;
  else if (old.created !== void 0)
    loss.dropped.push("created");
  for (const key of ["sources", "related", "tags", "aliases"]) {
    const list = stringArray(old[key]);
    if (list)
      fm[key] = list;
    else if (old[key] !== void 0)
      loss.dropped.push(key);
  }
  for (const [key, value] of Object.entries(old)) {
    if (key === "extra") {
      if (isRecord2(value))
        fm.extra = value;
      else
        loss.dropped.push(key);
      continue;
    }
    const kind = classifyFrontmatterKey(key);
    if (kind === "foreign")
      fm[key] = value;
    else if (kind === "near-miss")
      loss.dropped.push(key);
  }
  const result = validateFrontmatter(fm);
  if (!result.ok)
    return { error: result.errors.join("; ") };
  return { content: serializePage(result.value, body), loss };
}
function normalizeImport(files, opts) {
  const out = [];
  const skipped = [];
  const seen = /* @__PURE__ */ new Set();
  for (const file of files) {
    const pageId = pageIdFromPath(file.relPath);
    if (seen.has(pageId)) {
      skipped.push({ relPath: file.relPath, reason: "duplicate pageId" });
      continue;
    }
    try {
      parsePage(file.content);
      out.push({ relPath: file.relPath, content: file.content, pageId, action: "kept" });
      seen.add(pageId);
      continue;
    } catch {
    }
    const backfilled = backfill(file, opts);
    if ("error" in backfilled) {
      skipped.push({ relPath: file.relPath, reason: backfilled.error });
      continue;
    }
    const { content, loss } = backfilled;
    const lost = loss.dropped.length > 0 || loss.replaced.length > 0;
    out.push({
      relPath: file.relPath,
      content,
      pageId,
      action: "normalized",
      ...lost ? { loss } : {}
    });
    seen.add(pageId);
  }
  return { files: out, skipped };
}

// ../core/dist/ops/body-links.js
function isExternalUrl(ref) {
  const s = ref.trim();
  return /^[a-z][a-z0-9+.-]+:/i.test(s) || s.startsWith("//");
}
var WIKILINK_RE = /\[\[([^\][]+?)\]\]/g;
var MDLINK_RE = /(?<!!)\[[^\]]*\]\(([^)]+)\)/g;
function stripCode(body) {
  const lines = body.split("\n");
  const out = [];
  let fence = null;
  for (const line of lines) {
    const m = /^[ \t]*(`{3,}|~{3,})(.*)$/.exec(line);
    if (fence) {
      if (m && m[1][0] === fence[0] && m[1].length >= fence.length && (m[2] ?? "").trim() === "") {
        fence = null;
      }
      out.push("");
      continue;
    }
    if (m) {
      const isBacktick = m[1][0] === "`";
      if (!isBacktick || !(m[2] ?? "").includes("`")) {
        fence = m[1];
        out.push("");
        continue;
      }
    }
    out.push(stripInlineCode(line));
  }
  return out.join("\n");
}
function stripInlineCode(line) {
  return line.replace(/(`+)[^\n]*?\1/g, " ");
}
function wikilinkTarget(inner) {
  const beforeAlias = inner.split("|", 1)[0] ?? "";
  const beforeHeading = beforeAlias.split("#", 1)[0] ?? "";
  return beforeHeading.trim();
}
function mdlinkTarget(href) {
  const h = href.trim();
  if (!h || isExternalUrl(h) || h.startsWith("#") || h.startsWith("/"))
    return null;
  const target = (h.split("#", 1)[0] ?? "").trim();
  return target.length > 0 ? target : null;
}
function extractBodyLinks(body) {
  const text = stripCode(body);
  const seen = /* @__PURE__ */ new Set();
  const links = [];
  const add = (syntax, target) => {
    if (!target)
      return;
    const key = `${syntax} ${target}`;
    if (seen.has(key))
      return;
    seen.add(key);
    links.push({ syntax, target });
  };
  for (const m of text.matchAll(WIKILINK_RE))
    add("wikilink", wikilinkTarget(m[1] ?? ""));
  for (const m of text.matchAll(MDLINK_RE)) {
    const target = mdlinkTarget(m[1] ?? "");
    if (target)
      add("mdlink", target);
  }
  return links;
}
function buildBodyLinkResolver(pages) {
  const byId = /* @__PURE__ */ new Set();
  const byBasename = /* @__PURE__ */ new Map();
  const byTitle = /* @__PURE__ */ new Map();
  const add = (m, k, v) => {
    const set2 = m.get(k);
    if (set2)
      set2.add(v);
    else
      m.set(k, /* @__PURE__ */ new Set([v]));
  };
  for (const p of pages) {
    byId.add(p.pageId);
    if (p.active === false)
      continue;
    const base = (p.pageId.split("/").pop() ?? p.pageId).toLowerCase();
    add(byBasename, base, p.pageId);
    const title = p.title?.trim().toLowerCase();
    if (title)
      add(byTitle, title, p.pageId);
  }
  return (target) => {
    const raw = target.trim();
    if (!raw)
      return null;
    if (byId.has(raw))
      return raw;
    const key = raw.toLowerCase();
    const candidates = /* @__PURE__ */ new Set();
    for (const id of byBasename.get(key) ?? [])
      candidates.add(id);
    for (const id of byTitle.get(key) ?? [])
      candidates.add(id);
    return candidates.size === 1 ? candidates.values().next().value ?? null : null;
  };
}

// ../core/dist/ops/lint-detectors.js
function ageDays(updated, now) {
  const t = Date.parse(`${updated}T00:00:00.000Z`);
  if (Number.isNaN(t))
    return Number.POSITIVE_INFINITY;
  return Math.floor((now.getTime() - t) / 864e5);
}
function detectStale(input) {
  const findings = [];
  for (const p of input.subjects) {
    if (p.status !== "active")
      continue;
    const age = ageDays(p.updated, input.now);
    if (age > input.staleDays) {
      findings.push({
        kind: "stale",
        pageIds: [p.pageId],
        detail: `last updated ${p.updated} (${Number.isFinite(age) ? `${age} days ago` : "date unparseable"}); older than the ${input.staleDays}-day threshold`,
        suggestedAction: "review the page for accuracy and refresh it, or mark it deprecated if no longer current"
      });
    }
  }
  return findings;
}
function detectOrphans(input) {
  const findings = [];
  for (const p of input.subjects) {
    if (p.status !== "active")
      continue;
    if (p.pageId === CHARTER_PAGE_ID)
      continue;
    if (!input.inbound.has(p.pageId)) {
      findings.push({
        kind: "orphan",
        pageIds: [p.pageId],
        detail: "no other page links to this one (via `related` or an inline body link)",
        suggestedAction: "add a `related` entry (the canonical cross-reference) or an inline link from a relevant page, or confirm the page is an intentional entry point"
      });
    }
  }
  return findings;
}
function detectBrokenCitations(input) {
  const findings = [];
  for (const p of input.subjects) {
    const broken = [];
    for (const ref of p.sources) {
      if (isExternalUrl(ref))
        continue;
      const path = ref.startsWith(`${WIKI_LAYOUT.sourcesDir}/`) ? ref : `${WIKI_LAYOUT.sourcesDir}/${ref}`;
      if (!input.sourcePaths.has(path))
        broken.push(`source "${ref}"`);
    }
    for (const ref of p.related) {
      if (!input.existingPageIds.has(ref))
        broken.push(`related page "${ref}"`);
    }
    if (broken.length > 0) {
      findings.push({
        kind: "broken-citation",
        pageIds: [p.pageId],
        detail: `references that no longer exist: ${broken.join(", ")}`,
        suggestedAction: "fix or remove the dangling reference(s) in the page frontmatter"
      });
    }
  }
  return findings;
}
var PROVENANCE_OPENERS = /^(stated|said|captured|recorded|written|noted|documented|transcribed)\b|^(the )?canonical page\b|^an? [a-z-]* ?(adr|decision record)\b|^this (page|note|file|document)\b/i;
var SAMPLE_SIZE = 5;
function detectThinSummaries(input) {
  const thin = [];
  for (const p of input.subjects) {
    if (p.status !== "active")
      continue;
    if (p.pageId === CHARTER_PAGE_ID)
      continue;
    const summary = p.summary?.trim();
    if (!summary || p.derivedSummary !== void 0 && summary === p.derivedSummary.trim() || PROVENANCE_OPENERS.test(summary)) {
      thin.push(p.pageId);
    }
  }
  if (thin.length === 0)
    return [];
  const sample = thin.slice(0, SAMPLE_SIZE);
  const more = thin.length - sample.length;
  return [
    {
      kind: "thin-summary",
      pageIds: thin,
      detail: `${thin.length} page(s) have no authored \`summary:\` \u2014 their catalog line falls back to the first body line, which is also what search matches against: ${sample.join(", ")}${more > 0 ? `, +${more} more` : ""}`,
      suggestedAction: "write a `summary:` on each \u2014 one plain-text line, \u2264140 chars, naming the concrete things the page covers"
    }
  ];
}
function runDeterministicLint(input) {
  return [
    ...detectStale(input),
    ...detectOrphans(input),
    ...detectBrokenCitations(input),
    ...detectThinSummaries(input)
  ];
}

