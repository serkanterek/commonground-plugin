async function resolveMaintainerSkillPayload() {
  let pkgPath;
  try {
    pkgPath = require2.resolve("@commonground/maintainer-skill/package.json");
  } catch {
    return null;
  }
  const pkg = JSON.parse(await (0, import_promises4.readFile)(pkgPath, "utf8"));
  const files = Array.isArray(pkg.files) ? pkg.files.filter((f) => typeof f === "string") : [];
  return { dir: (0, import_node_path5.dirname)(pkgPath), files };
}
var ROUTER_START = "<!-- commonground:router-rule:start -->";
var ROUTER_END = "<!-- commonground:router-rule:end -->";
var MODE_MARKER_RE = /<!-- commonground:mode:(mcp|local) -->/;
function modeMarker(mode) {
  return `
<!-- commonground:mode:${mode} -->`;
}
function briefBullet(voice) {
  const capped = sanitizeBrief((voice?.retrievalBrief ?? "").replace(/<!--|-->/g, " "));
  return capped ? `
- The wiki's charter states when to consult it: "${capped}"` : "";
}
function excludesBullet(voice) {
  const capped = sanitizeBrief((voice?.excludes ?? "").replace(/<!--|-->/g, " "));
  return capped ? `
- It also states what does NOT belong here: "${capped}" \u2014 don't file that material here, and don't expect to find it.` : "";
}
function cloneRouterRule(voice) {
  const v = wikiVoice(voice?.audience);
  return `${ROUTER_START}${modeMarker("local")}
## CommonGround \u2014 context wiki (auto-managed by the sync agent)

This folder is ${v.possessive} CommonGround ${v.noun} \u2014 the working copy. The hosted repo is
what the team shares; \`/commonground:push\` is how work here becomes theirs. ${v.when}

- Start at \`index.md\` (the catalog) and open only the pages you need \u2014 load context on demand.${briefBullet(voice)}${excludesBullet(voice)}
${v.cite}
- Raw inputs are under \`sources/\`; change history is in \`log.md\`.
- To curate (ingest / edit / lint / seed), use the maintainer skill in \`.commonground/maintainer-skill/\`.
- **Curation edits the files here \u2014 never the CommonGround MCP write tools.** \`save_page\`,
  \`stage_sources\` and \`save_charter\` write the team's hosted wiki directly, skipping this copy
  and the publish step. Nothing reaches the team until \`/commonground:push\`.

Do not edit inside this block \u2014 the sync agent regenerates it. Put your own notes outside it.
${ROUTER_END}`;
}
var CLONE_ROUTER_RULE = cloneRouterRule();
function mcpRouterRule(voice) {
  const v = wikiVoice(voice?.audience);
  return `${ROUTER_START}
## CommonGround \u2014 context wiki (via the CommonGround plugin)

${capitalize(v.possessive)} CommonGround ${v.noun} is available in this session through the
CommonGround MCP connector. ${v.when}

- Use the CommonGround tools \u2014 \`get_index\` (the catalog), \`search\` (find pages), \`get_page\`
  (read one in full). Load context on demand; don't read everything.${briefBullet(voice)}${excludesBullet(voice)}
${v.cite}
- **There is no local copy in this project, so every write is immediately shared.** \`save_page\`,
  \`stage_sources\` and \`save_charter\` commit straight to the hosted wiki \u2014 the moment one lands,
  it is what everyone else's Claude reads. Show what you intend to write and get an explicit yes
  before each write; there is no staging step to undo it in.
- If the connector needs authentication \u2014 or its CommonGround tools stop appearing mid-session,
  which a plugin update can cause \u2014 run \`/mcp\` to (re)connect and complete the browser sign-in, or
  restart the session. Missing tools are a CONNECTION problem, never a permissions one: don't tell
  the user they lack access. \`commonground pull [team]\` still reads the wiki meanwhile \u2014 it
  authenticates as the signed-in device rather than through the connector \u2014 so offer it (it writes
  a readable copy of the wiki to disk, so ask first).
- To curate (admins only in v1), use the CommonGround maintainer skill / \`/commonground:*\` commands.

Do not edit inside this block \u2014 CommonGround regenerates it. Put your own notes outside it.
${ROUTER_END}`;
}
function localRouterRule(clonePath2, voice) {
  const v = wikiVoice(voice?.audience);
  return `${ROUTER_START}
## CommonGround \u2014 context wiki (local clone)

${capitalize(v.possessive)} CommonGround ${v.noun} is cloned at \`${clonePath2}\`. That clone is
**the working copy for this project** \u2014 the hosted repo is what the team shares, and
\`/commonground:push\` is how work here becomes theirs. ${v.when}

- Start at \`${clonePath2}/index.md\` (the catalog) and open only the pages you need.${briefBullet(voice)}${excludesBullet(voice)}
${v.cite}
- Raw inputs are under \`sources/\`; change history is in \`log.md\`. Use \`/commonground:pull\` to get
  the team's latest and \`/commonground:push\` to publish your changes (it commits for you).
- **Curation writes FILES in that clone \u2014 never the CommonGround MCP write tools.** Do not call
  \`save_page\`, \`stage_sources\` or \`save_charter\` in this project: they write the team's hosted
  wiki directly, skipping the user's review and the publish step. Ingesting, editing, linting,
  seeding and chartering all mean editing files under \`${clonePath2}\`. Nothing reaches the team
  until \`/commonground:push\`, which previews and asks first.
- **Read from the clone too** \u2014 it is current with the user's own unpushed work, which the hosted
  wiki is not. The one thing the clone genuinely cannot hold is the suggestions queue
  (\`list_suggestions\` / \`suggest_change\` / \`resolve_suggestion\`), which lives server-side
  because it carries messages from people who have no write access to the repo.
- Curating locally needs no particular role \u2014 it is the user's own copy. Only **publishing** is
  admin/curator (\`/commonground:push\` reports this rather than failing).

Do not edit inside this block \u2014 CommonGround regenerates it. Put your own notes outside it.
${ROUTER_END}`;
}
function capitalize(s) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}
var TEAM_MARKER_RE = /<!-- commonground:team:([^\s>]+) -->/;
function teamMarker(teamId) {
  return teamId ? `
<!-- commonground:team:${teamId} -->` : "";
}
function routerRuleForMode(mode, opts = {}) {
  const rule = mode === "local" ? (() => {
    if (!opts.clonePath)
      throw new Error("local router mode requires a clonePath");
    return localRouterRule(opts.clonePath, opts.voice);
  })() : mcpRouterRule(opts.voice);
  return rule.replace(ROUTER_START, `${ROUTER_START}${teamMarker(opts.teamId)}${modeMarker(mode)}`);
}
function parseRouterBlock(claudeMd) {
  const block = /<!-- commonground:router-rule:start -->([\s\S]*?)<!-- commonground:router-rule:end -->/.exec(claudeMd)?.[1];
  if (!block)
    return null;
  const marked = MODE_MARKER_RE.exec(block)?.[1];
  return {
    mode: marked === "local" || marked === "mcp" ? marked : block.includes("(local clone)") ? "local" : "mcp",
    teamId: TEAM_MARKER_RE.exec(block)?.[1] ?? null
  };
}
async function charterVoiceFromWiki(wikiDir) {
  const raw = await readFileOr((0, import_node_path5.join)(wikiDir, `${CHARTER_PAGE_ID}.md`), "");
  if (!raw)
    return null;
  const fence = raw.startsWith("---") ? /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(raw) : null;
  if (fence && /^status:\s*(deprecated|hypothetical)\s*$/m.test(fence[1]))
    return null;
  const body = fence ? raw.slice(fence[0].length) : raw;
  const charter = parseCharter(body);
  return {
    audience: charter.audience,
    retrievalBrief: charter.retrievalBrief,
    excludes: charter.excludes
  };
}
var BLOCK_RE = /<!-- commonground:router-rule:start -->[\s\S]*?<!-- commonground:router-rule:end -->/g;
var BRIEF_START = "<!-- commonground:retrieval-brief:start -->";
var BRIEF_END = "<!-- commonground:retrieval-brief:end -->";
var BRIEF_BLOCK_RE = /<!-- commonground:retrieval-brief:start -->[\s\S]*?<!-- commonground:retrieval-brief:end -->/g;
var EXCLUDED = ["/CLAUDE.md", `/${WIKI_LAYOUT.configDir}/maintainer-skill/`];
async function injectRouterRule(dir, rule = CLONE_ROUTER_RULE) {
  const path = (0, import_node_path5.join)(dir, "CLAUDE.md");
  const existing = await readFileOr(path, "");
  const cleaned = existing.replace(BLOCK_RE, "").replace(BRIEF_BLOCK_RE, "").split("\n").filter((line) => {
    const t = line.trim();
    return t !== ROUTER_START && t !== ROUTER_END && t !== BRIEF_START && t !== BRIEF_END;
  }).join("\n").trimEnd();
  const next = cleaned.length > 0 ? `${cleaned}

${rule}
` : `${rule}
`;
  await (0, import_promises4.writeFile)(path, next, "utf8");
}
async function injectSkill(dir, payload) {
  const resolved = payload === void 0 ? await resolveMaintainerSkillPayload() : payload;
  if (!resolved)
    return;
  const dest = (0, import_node_path5.join)(dir, WIKI_LAYOUT.configDir, "maintainer-skill");
  await (0, import_promises4.mkdir)(dest, { recursive: true });
  for (const file of resolved.files) {
    await (0, import_promises4.copyFile)((0, import_node_path5.join)(resolved.dir, file), (0, import_node_path5.join)(dest, file));
  }
}
async function excludeInjected(dir) {
  const path = (0, import_node_path5.join)(dir, ".git", "info", "exclude");
  const existing = await readFileOr(path, "");
  const have = new Set(existing.split("\n").map((l) => l.trim()));
  const missing = EXCLUDED.filter((line) => !have.has(line));
  if (missing.length === 0)
    return;
  await (0, import_promises4.mkdir)((0, import_node_path5.dirname)(path), { recursive: true });
  const body = existing.trimEnd();
  await (0, import_promises4.writeFile)(path, `${body ? `${body}
` : ""}${missing.join("\n")}
`, "utf8");
}
async function injectAll(dir) {
  await excludeInjected(dir);
  await injectRouterRule(dir, cloneRouterRule(await charterVoiceFromWiki(dir)));
  await injectSkill(dir);
}
async function readFileOr(path, fallback) {
  try {
    return await (0, import_promises4.readFile)(path, "utf8");
  } catch {
    return fallback;
  }
}

// ../../apps/sync-agent/dist/commands.js
async function login(deps, token) {
  const identity = await deps.backend.resolveIdentity(token);
  if (!identity)
    throw new AgentError("invalid or unknown device token");
  const binding = {
    token,
    userId: identity.userId,
    teamId: identity.teamId,
    role: identity.role
  };
  await writeBinding(binding, deps.configHome, deps.dataHome);
  return binding;
}
function apiUrl(apiBaseUrl, path) {
  const url = new URL(apiBaseUrl);
  url.pathname = `${url.pathname.replace(/\/$/, "")}${path}`;
  return url;
}
var PENDING_FILE = "device-login.json";
function pendingPath(configHome) {
  return (0, import_node_path6.join)(configHome, PENDING_FILE);
}
async function writePendingLogin(configHome, p) {
  await (0, import_promises5.mkdir)(configHome, { recursive: true, mode: 448 });
  await (0, import_promises5.writeFile)(pendingPath(configHome), JSON.stringify(p), { mode: 384 });
  await (0, import_promises5.chmod)(pendingPath(configHome), 384);
}
async function readPendingLogin(configHome, nowMs = Date.now()) {
  try {
    const raw = JSON.parse(await (0, import_promises5.readFile)(pendingPath(configHome), "utf8"));
    if (typeof raw?.deviceCode !== "string" || !raw.deviceCode)
      return null;
    if (typeof raw.expiresAtMs !== "number" || raw.expiresAtMs <= nowMs)
      return null;
    return { deviceCode: raw.deviceCode, expiresAtMs: raw.expiresAtMs, intervalSec: raw.intervalSec || 5 };
  } catch {
    return null;
  }
}
async function clearPendingLogin(configHome) {
  await (0, import_promises5.rm)(pendingPath(configHome), { force: true }).catch(() => void 0);
}
async function startDeviceLogin(deps) {
  const now = deps.now ?? Date.now;
  const startRes = await fetch(apiUrl(deps.apiBaseUrl, "/device/authorize"), { method: "POST" });
  if (!startRes.ok)
    throw new AgentError(`could not start device authorization (${startRes.status})`);
  const start = await startRes.json();
  await writePendingLogin(deps.configHome, {
    deviceCode: start.device_code,
    expiresAtMs: now() + start.expires_in * 1e3,
    intervalSec: Math.max(start.interval, 1)
  });
  const prompt = {
    verificationUri: start.verification_uri,
    verificationUriComplete: start.verification_uri_complete,
    userCode: start.user_code,
    expiresInSec: start.expires_in
  };
  await deps.onPrompt(prompt);
  return prompt;
}
async function waitDeviceLogin(deps, budgetMs) {
  const now = deps.now ?? Date.now;
  const pending = await readPendingLogin(deps.configHome, now());
  if (!pending) {
    throw new AgentError('no device login is in progress (or it expired) \u2014 start one with "commonground login --start"');
  }
  const giveUpAt = Math.min(now() + budgetMs, pending.expiresAtMs);
  while (now() < giveUpAt) {
    await deps.sleep(pending.intervalSec * 1e3);
    const res = await fetch(apiUrl(deps.apiBaseUrl, "/device/token"), {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ device_code: pending.deviceCode })
    });
    if (res.ok) {
      const body = await res.json();
      const binding = {
        token: body.access_token,
        userId: body.userId,
        teamId: body.teamId,
        role: body.role
      };
      await writeBinding(binding, deps.configHome, deps.dataHome);
      await clearPendingLogin(deps.configHome);
      return binding;
    }
    const err = (await res.json().catch(() => ({}))).error;
    if (err === "slow_down")
      continue;
    if (err !== "authorization_pending") {
      await clearPendingLogin(deps.configHome);
      throw new AgentError(`device authorization failed (${err ?? res.status})`);
    }
  }
  return "pending";
}
async function browserLogin(deps) {
  const now = deps.now ?? Date.now;
  const startRes = await fetch(apiUrl(deps.apiBaseUrl, "/device/authorize"), { method: "POST" });
  if (!startRes.ok)
    throw new AgentError(`could not start device authorization (${startRes.status})`);
  const start = await startRes.json();
  await deps.onPrompt({
    verificationUri: start.verification_uri,
    verificationUriComplete: start.verification_uri_complete,
    userCode: start.user_code,
    expiresInSec: start.expires_in
  });
  const deadline = now() + start.expires_in * 1e3;
  let intervalMs = Math.max(start.interval, 1) * 1e3;
  while (now() < deadline) {
    await deps.sleep(intervalMs);
    const res = await fetch(apiUrl(deps.apiBaseUrl, "/device/token"), {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ device_code: start.device_code })
    });
    if (res.ok) {
      const body = await res.json();
      const binding = {
        token: body.access_token,
        userId: body.userId,
        teamId: body.teamId,
        role: body.role
      };
      await writeBinding(binding, deps.configHome, deps.dataHome);
      return binding;
    }
    const err = (await res.json().catch(() => ({}))).error;
    if (err === "authorization_pending")
      continue;
    if (err === "slow_down") {
      intervalMs += 5e3;
      continue;
    }
    if (err === "access_denied")
      throw new AgentError("device authorization was denied");
    if (err === "expired_token")
      throw new AgentError('the authorization expired \u2014 run "commonground login" again');
    throw new AgentError(`device authorization failed (${err ?? res.status})`);
  }
  throw new AgentError('timed out waiting for authorization \u2014 run "commonground login" again');
}
async function initProject(deps, opts) {
  const { mode, teamId, projectDir } = opts;
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  if (mode === "local") {
    const synced = await sync(deps, teamId);
    const voice2 = await charterVoiceFromWiki(synced.clonePath);
    await injectRouterRule(projectDir, routerRuleForMode("local", { clonePath: synced.clonePath, voice: voice2, teamId }));
    return { mode, teamId, projectDir, clonePath: synced.clonePath, synced };
  }
  const voice = await deps.backend.fetchCharter?.(teamId) ?? null;
  await injectRouterRule(projectDir, routerRuleForMode("mcp", { voice, teamId }));
  return { mode, teamId, projectDir };
}
async function detectRouterBlock(projectDir) {
  try {
    return parseRouterBlock(await (0, import_promises5.readFile)((0, import_node_path6.join)(projectDir, "CLAUDE.md"), "utf8"));
  } catch {
    return null;
  }
}
var isReservedImportPath = isReservedPath;
function isInside2(parent, child) {
  const rel = (0, import_node_path6.relative)((0, import_node_path6.resolve)(parent), (0, import_node_path6.resolve)(child));
  return rel === "" || !rel.startsWith("..") && !(0, import_node_path6.isAbsolute)(rel);
}
async function importWiki(deps, opts) {
  const { sourceDir, teamId } = opts;
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  if (!can(binding.role, "wiki:edit")) {
    throw new AgentError(`role "${binding.role}" can't import \u2014 only admins/curators may write the wiki`);
  }
  if (!await isDir(sourceDir))
    throw new AgentError(`not a folder: ${sourceDir}`);
  const dir = clonePath(teamId, deps.dataHome);
  const remote = await deps.backend.remoteAccess(teamId);
  if (!await pathExists2(dir)) {
    await cloneRepo(remote.url, dir, remote.env);
    await injectAll(dir);
  }
  const guardedHomes = [
    deps.configHome,
    ...isInside2(deps.dataHome, sourceDir) ? [] : [deps.dataHome]
  ];
  const notImported = await overlaySource(sourceDir, dir, guardedHomes);
  const today = (/* @__PURE__ */ new Date()).toISOString().slice(0, 10);
  const { normalized, skipped, lossy } = await normalizeAndReindex(dir, sourceDir, teamId, today);
  await runGit(dir, ["add", "-A"]);
  const staged = (await runGit(dir, ["diff", "--cached", "--name-only"])).split("\n").filter(Boolean);
  if (staged.length === 0) {
    return {
      teamId,
      sourceDir,
      clonePath: dir,
      imported: 0,
      normalized,
      skipped,
      nothingToImport: true,
      // A no-op import still refused these — the receipt must say so on this path too.
      ...notImported.length ? { notImported } : {},
      ...lossy.length ? { lossy } : {}
    };
  }
  await appendLog(dir, buildLogLine({ date: today, op: "ingest", title: `Imported wiki from ${(0, import_node_path6.basename)(sourceDir)}` }));
  await runGit(dir, ["add", WIKI_LAYOUT.logFile]);
  const who = agentAuthor(binding);
  await runGit(dir, [
    "-c",
    `user.email=${who.email}`,
    "-c",
    `user.name=${who.name}`,
    "commit",
    "-m",
    `import wiki from ${(0, import_node_path6.basename)(sourceDir)}`
  ]);
  const synced = await sync(deps, teamId);
  return {
    teamId,
    sourceDir,
    clonePath: dir,
    imported: staged.length,
    normalized,
    skipped,
    synced,
    ...notImported.length ? { notImported } : {},
    ...lossy.length ? { lossy } : {}
  };
}
async function overlaySource(sourceDir, dir, guardedHomes) {
  const allowed = (src, alsoReject) => {
    const rel = (0, import_node_path6.relative)(sourceDir, src);
    if (rel === "")
      return true;
    if (isReservedImportPath(rel) || alsoReject(rel))
      return false;
    return !guardedHomes.some((home) => isInside2(home, src));
  };
  await (0, import_promises5.cp)(sourceDir, dir, {
    recursive: true,
    force: true,
    filter: (src) => allowed(src, isRawSourcePath)
  });
  const notImported = [];
  for (const relPath of RESERVED_ROOT_NAMES) {
    if (await pathExists2((0, import_node_path6.join)(sourceDir, relPath))) {
      notImported.push({ relPath, reason: RESERVED_ROOT_REASON[relPath] });
    }
  }
  const sourcesDir = (0, import_node_path6.join)(sourceDir, WIKI_LAYOUT.sourcesDir);
  if (await isDir(sourcesDir)) {
    for (const rel of await walkFiles(sourcesDir, () => true)) {
      const existing = (0, import_node_path6.join)(dir, WIKI_LAYOUT.sourcesDir, rel);
      if (await pathExists2(existing) && await differs(existing, (0, import_node_path6.join)(sourcesDir, rel))) {
        notImported.push({
          relPath: `${WIKI_LAYOUT.sourcesDir}/${rel}`,
          reason: "a DIFFERENT raw source already exists at this path \u2014 sources/ is immutable"
        });
      }
    }
    await (0, import_promises5.cp)(sourcesDir, (0, import_node_path6.join)(dir, WIKI_LAYOUT.sourcesDir), {
      recursive: true,
      force: false,
      // copy-if-absent: an existing raw source keeps its original bytes…
      errorOnExist: false,
      // …and a collision is a reported no-op, not a thrown import
      filter: (src) => allowed(src, () => false)
    });
  }
  return notImported;
}
async function differs(a, b) {
  try {
    const [statA, statB] = await Promise.all([(0, import_promises5.stat)(a), (0, import_promises5.stat)(b)]);
    if (statA.size !== statB.size)
      return true;
    const [bytesA, bytesB] = await Promise.all([(0, import_promises5.readFile)(a), (0, import_promises5.readFile)(b)]);
    return !bytesA.equals(bytesB);
  } catch {
    return true;
  }
}
var RESERVED_ROOT_REASON = {
  "CLAUDE.md": "CommonGround owns the wiki folder's CLAUDE.md (the injected router block)",
  [WIKI_LAYOUT.indexFile]: "the catalog is regenerated from the whole wiki",
  [WIKI_LAYOUT.logFile]: "the change log is append-only \u2014 the team's history stays"
};
async function walkFiles(root, keep) {
  const out = [];
  async function walk2(abs, rel) {
    let entries;
    try {
      entries = await (0, import_promises5.readdir)(abs, { withFileTypes: true });
    } catch {
      return;
    }
    for (const e of entries) {
      const childRel = rel ? `${rel}/${e.name}` : e.name;
      if (e.isDirectory()) {
        if (!RESERVED_SEGMENTS.has(e.name.normalize("NFC").toLowerCase())) {
          await walk2((0, import_node_path6.join)(abs, e.name), childRel);
        }
      } else if (e.isFile() && keep(childRel)) {
        out.push(childRel);
      }
    }
  }
  await walk2(root, "");
  return out;
}
async function walkMarkdown(root) {
  return walkFiles(root, (rel) => rel.endsWith(".md"));
}
async function normalizeAndReindex(dir, sourceDir, teamId, today) {
  const importedRel = (await walkMarkdown(sourceDir)).filter(isWikiPagePath);
  const importFiles = [];
  for (const relPath of importedRel) {
    try {
      const content = await (0, import_promises5.readFile)((0, import_node_path6.join)(dir, relPath), "utf8");
      const mtime = await mtimeDate((0, import_node_path6.join)(sourceDir, relPath));
      importFiles.push({ relPath, content, ...mtime ? { mtime } : {} });
    } catch {
      continue;
    }
  }
  const defaultScope = shapeDefaultScope("company", teamId);
  const result = normalizeImport(importFiles, { defaultScope, today });
  for (const f of result.files)
    await (0, import_promises5.writeFile)((0, import_node_path6.join)(dir, f.relPath), f.content, "utf8");
  if (result.skipped.length > 0) {
    const lines = result.skipped.map((s) => `  ${s.relPath}: ${s.reason}`).join("\n");
    process.stderr.write(`commonground import: left ${result.skipped.length} file(s) unnormalized (couldn't build valid frontmatter):
${lines}
`);
  }
  const lossy = result.files.filter((f) => f.loss !== void 0).map((f) => ({ relPath: f.relPath, loss: f.loss }));
  if (lossy.length > 0) {
    const lines = lossy.map((f) => {
      const dropped = f.loss.dropped.length ? `
    dropped: ${f.loss.dropped.join(", ")}` : "";
      const replaced = f.loss.replaced.length ? `
    replaced: ${f.loss.replaced.join(", ")}` : "";
      return `  ${f.relPath}${dropped}${replaced}`;
    }).join("\n");
    process.stderr.write(`commonground import: ${lossy.length} page(s) lost frontmatter detail on the way in:
${lines}
`);
  }
  await rebuildIndex(dir);
  const normalized = result.files.filter((f) => f.action === "normalized").length;
  return { normalized, skipped: result.skipped.length, lossy };
}
async function rebuildIndex(dir) {
  const entries = [];
  for (const relPath of (await walkMarkdown(dir)).filter(isWikiPagePath)) {
    let parsed;
    try {
      parsed = parsePage(await (0, import_promises5.readFile)((0, import_node_path6.join)(dir, relPath), "utf8"));
    } catch {
      continue;
    }
    entries.push(toIndexEntry({ pageId: pageIdFromPath(relPath), ...parsed }));
  }
  await (0, import_promises5.writeFile)((0, import_node_path6.join)(dir, WIKI_LAYOUT.indexFile), regenerateIndex(entries), "utf8");
}
async function mtimeDate(path) {
  try {
    return (await (0, import_promises5.stat)(path)).mtime.toISOString().slice(0, 10);
  } catch {
    return void 0;
  }
}
async function appendLog(dir, line) {
  const path = (0, import_node_path6.join)(dir, WIKI_LAYOUT.logFile);
  let existing = "";
  try {
    existing = await (0, import_promises5.readFile)(path, "utf8");
  } catch {
  }
  const sep = existing.length === 0 || existing.endsWith("\n") ? "" : "\n";
  await (0, import_promises5.writeFile)(path, `${existing}${sep}${line}
`, "utf8");
}
async function isDir(path) {
  try {
    return (await (0, import_promises5.stat)(path)).isDirectory();
  } catch {
    return false;
  }
}
function pageIdFromPath2(path) {
  return path.endsWith(".md") ? path.slice(0, -3) : path;
}
function kindFromStatus(status2) {
  switch (status2[0]) {
    case "A":
      return "added";
    case "D":
      return "deleted";
    case "R":
      return "renamed";
    default:
      return "modified";
  }
}
function toPageChanges(entries) {
  return entries.map((e) => ({
    kind: kindFromStatus(e.status),
    page: pageIdFromPath2(e.path),
    path: e.path
  }));
}
async function sync(deps, teamId, opts = {}) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const dir = clonePath(teamId, deps.dataHome);
  const origin = await deps.backend.remoteAccess(teamId);
  if (!await pathExists2(dir)) {
    await cloneRepo(origin.url, dir, origin.env);
    await injectAll(dir);
    return { teamId, clonePath: dir, action: "cloned", ahead: 0, behind: 0 };
  }
  await refreshRemote(dir, origin);
  const branch = await currentBranch(dir);
  const remote = `origin/${branch}`;
  const { ahead, behind } = await aheadBehind(dir, "HEAD", remote);
  if (behind > 0 && (ahead > 0 || !await isWorkingTreeClean(dir))) {
    return { teamId, clonePath: dir, action: "diverged", ahead, behind };
  }
  if (behind > 0) {
    const incoming = toPageChanges(await diffNameStatus(dir, "HEAD", remote));
    try {
      await fastForward(dir, remote);
    } catch (e) {
      if (e instanceof GitError && /would be overwritten by/i.test(e.stderr)) {
        return { teamId, clonePath: dir, action: "diverged", ahead, behind };
      }
      throw e;
    }
    await injectAll(dir);
    return { teamId, clonePath: dir, action: "fast-forwarded", ahead: 0, behind, pages: incoming };
  }
  await injectAll(dir);
  if (ahead > 0) {
    if (can(binding.role, "wiki:edit")) {
      const pushed = toPageChanges(await diffNameStatus(dir, remote, "HEAD"));
      const deletions = toPageChanges(await diffNameStatus(dir, remote, "HEAD", { noRenames: true })).filter((p) => p.kind === "deleted");
      if (deletions.length > 0 && !opts.allowDeletes) {
        return {
          teamId,
          clonePath: dir,
          action: "blocked-deletes",
          ahead,
          behind,
          pages: pushed,
          deletions
        };
      }
      await pushBranch(dir, branch, origin.env);
      return {
        teamId,
        clonePath: dir,
        action: "pushed",
        ahead,
        behind,
        pages: pushed,
        deletions: deletions.length ? deletions : void 0
      };
    }
    return { teamId, clonePath: dir, action: "local-only", ahead, behind };
  }
  return { teamId, clonePath: dir, action: "up-to-date", ahead, behind };
}
async function commitAllIfAny(dir, binding, message) {
  await runGit(dir, ["add", "-A"]);
  const staged = (await runGit(dir, ["diff", "--cached", "--name-only"])).split("\n").filter(Boolean);
  if (staged.length === 0)
    return false;
  const who = agentAuthor(binding);
  await runGit(dir, [
    "-c",
    `user.email=${who.email}`,
    "-c",
    `user.name=${who.name}`,
    "commit",
    "-m",
    message
  ]);
  return true;
}
async function runGitOverPaths(dir, args, paths) {
  const CHUNK = 100;
  for (let i = 0; i < paths.length; i += CHUNK) {
    await runGit(dir, [...args, "--", ...paths.slice(i, i + CHUNK)]);
  }
}
async function snapshotToDraft(dir, binding, label) {
  const l = label ?? (/* @__PURE__ */ new Date()).toISOString().replace(/[:.]/g, "-");
  const branch = `draft/${l}`;
  const snapshot = await snapshotWorkingTree(dir, `commonground draft ${l}`, agentAuthor(binding));
  await createBranch(dir, branch, snapshot);
  return branch;
}
async function refreshTeamProfile(deps, teamId, token) {
  try {
    const identity = await deps.backend.resolveIdentity(token);
    if (!identity || identity.teamId !== teamId)
      return;
    await writeTeamProfile(teamId, { teamName: identity.teamName, shape: identity.shape }, deps.configHome);
  } catch {
  }
}
async function pull(deps, teamId, opts = {}) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const dir = clonePath(teamId, deps.dataHome);
  const origin = await deps.backend.remoteAccess(teamId);
  await refreshTeamProfile(deps, teamId, binding.token);
  if (!await pathExists2(dir)) {
    await cloneRepo(origin.url, dir, origin.env);
    await injectAll(dir);
    return { teamId, clonePath: dir, action: "cloned", ahead: 0, behind: 0, dirty: false };
  }
  await refreshRemote(dir, origin);
  const branch = await currentBranch(dir);
  const remote = `origin/${branch}`;
  const { ahead, behind } = await aheadBehind(dir, "HEAD", remote);
  const dirty = !await isWorkingTreeClean(dir);
  if (behind === 0) {
    await injectAll(dir);
    return { teamId, clonePath: dir, action: "up-to-date", ahead, behind, dirty };
  }
  const incoming = toPageChanges(await diffNameStatus(dir, await mergeBase(dir, "HEAD", remote), remote));
  if (ahead === 0 && !dirty) {
    try {
      await fastForward(dir, remote);
    } catch (e) {
      if (e instanceof GitError && /would be overwritten by/i.test(e.stderr)) {
        return { teamId, clonePath: dir, action: "blocked", ahead, behind, dirty, pages: incoming };
      }
      throw e;
    }
    await injectAll(dir);
    return {
      teamId,
      clonePath: dir,
      action: "fast-forwarded",
      ahead: 0,
      behind,
      dirty: false,
      pages: incoming
    };
  }
  if (!opts.takeRemote) {
    return { teamId, clonePath: dir, action: "blocked", ahead, behind, dirty, pages: incoming };
  }
  const { draftBranch } = await resolveDivergence(deps, teamId, "take-remote");
  return {
    teamId,
    clonePath: dir,
    action: "took-remote",
    ahead,
    behind,
    dirty,
    pages: incoming,
    draftBranch
  };
}
async function push(deps, teamId, opts = {}) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const dir = clonePath(teamId, deps.dataHome);
  if (!await pathExists2(dir))
    throw new AgentError(`no local clone for "${teamId}" \u2014 run "commonground pull" first`);
  const origin = await deps.backend.remoteAccess(teamId);
  if (!can(binding.role, "wiki:edit")) {
    let pages;
    try {
      await refreshRemote(dir, origin);
      const base = await mergeBase(dir, "HEAD", `origin/${await currentBranch(dir)}`);
      const snapshot = await snapshotWorkingTree(dir, "commonground preview", agentAuthor(binding));
      const pending = toPageChanges(await diffNameStatus(dir, base, snapshot));
      if (pending.length > 0)
        pages = pending;
    } catch {
    }
    return { teamId, clonePath: dir, action: "read-only", ahead: 0, behind: 0, pages };
  }
  if (opts.dryRun) {
    await refreshRemote(dir, origin);
    const remoteRef = `origin/${await currentBranch(dir)}`;
    const { ahead: a, behind: b } = await aheadBehind(dir, "HEAD", remoteRef);
    const base = await mergeBase(dir, "HEAD", remoteRef);
    const snapshot = await snapshotWorkingTree(dir, "commonground preview", agentAuthor(binding));
    const pending = toPageChanges(await diffNameStatus(dir, base, snapshot));
    const wouldDelete = pending.filter((p) => p.kind === "deleted");
    return {
      teamId,
      clonePath: dir,
      action: "preview",
      ahead: a,
      behind: b,
      pages: pending,
      deletions: wouldDelete.length ? wouldDelete : void 0,
      incoming: b > 0 ? toPageChanges(await diffNameStatus(dir, base, remoteRef)) : []
    };
  }
  if (!await isWorkingTreeClean(dir))
    await rebuildIndex(dir);
  await commitAllIfAny(dir, binding, "curate wiki");
  await refreshRemote(dir, origin);
  const branch = await currentBranch(dir);
  const remote = `origin/${branch}`;
  let { ahead, behind } = await aheadBehind(dir, "HEAD", remote);
  let draftBranch;
  if (behind > 0) {
    const base = await mergeBase(dir, "HEAD", remote);
    const incoming = toPageChanges(await diffNameStatus(dir, base, remote));
    if (!opts.mine) {
      const outgoing = toPageChanges(await diffNameStatus(dir, base, "HEAD"));
      return {
        teamId,
        clonePath: dir,
        action: "blocked",
        ahead,
        behind,
        pages: outgoing,
        incoming
      };
    }
    draftBranch = await snapshotToDraft(dir, binding);
    const myChanges = await diffNameStatus(dir, base, draftBranch, { noRenames: true });
    const myEdits = myChanges.filter((n) => !n.status.startsWith("D")).map((n) => n.path);
    const myDeletions = myChanges.filter((n) => n.status.startsWith("D")).map((n) => n.path);
    await resetHardTo(dir, remote);
    await runGitOverPaths(dir, ["checkout", draftBranch], myEdits);
    await runGitOverPaths(dir, ["rm", "-f", "--ignore-unmatch"], myDeletions);
    await injectAll(dir);
    await rebuildIndex(dir);
    await commitAllIfAny(dir, binding, "curate wiki (published over hosted changes)");
    ({ ahead, behind } = await aheadBehind(dir, "HEAD", remote));
  }
  if (ahead === 0) {
    return { teamId, clonePath: dir, action: "nothing-to-push", ahead, behind, draftBranch };
  }
  const published = toPageChanges(await diffNameStatus(dir, remote, "HEAD"));
  const deletions = toPageChanges(await diffNameStatus(dir, remote, "HEAD", { noRenames: true })).filter((p) => p.kind === "deleted");
  if (deletions.length > 0 && !opts.allowDeletes) {
    return {
      teamId,
      clonePath: dir,
      action: "needs-delete-confirm",
      ahead,
      behind,
      pages: published,
      deletions,
      draftBranch
    };
  }
  await pushBranch(dir, branch, origin.env);
  return {
    teamId,
    clonePath: dir,
    action: draftBranch ? "published-mine" : "pushed",
    ahead,
    behind,
    pages: published,
    deletions: deletions.length ? deletions : void 0,
    draftBranch,
    // Read AFTER the push so it names the commit the team actually received.
    commitId: await headOid(dir)
  };
}
async function exportWiki(deps, teamId, opts = {}) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const dir = clonePath(teamId, deps.dataHome);
  if (!await pathExists2(dir))
    throw new AgentError(`no local clone for "${teamId}" \u2014 run "commonground pull" first`);
  const out = opts.out ?? (0, import_node_path6.join)(deps.dataHome, `${teamId}-wiki.tar`);
  await archiveHead(dir, out);
  return { path: out };
}
async function status(deps, teamId) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const legacy = await legacyCredentialState(deps.configHome, deps.dataHome);
  const legacyCredential = legacy ? { legacyCredential: legacy } : {};
  const dir = clonePath(teamId, deps.dataHome);
  if (!await pathExists2(dir)) {
    return {
      teamId,
      role: binding.role,
      state: "not-cloned",
      ahead: 0,
      behind: 0,
      dirty: false,
      changedFiles: [],
      changedPages: [],
      ...legacyCredential
    };
  }
  await refreshRemote(dir, await deps.backend.remoteAccess(teamId));
  const remote = `origin/${await currentBranch(dir)}`;
  const { ahead, behind } = await aheadBehind(dir, "HEAD", remote);
  const dirty = !await isWorkingTreeClean(dir);
  const hasLocal = ahead > 0 || dirty;
  const state = behind > 0 && hasLocal ? "diverged" : behind > 0 ? "behind" : hasLocal ? "ahead" : "up-to-date";
  const changedPages = behind > 0 ? toPageChanges(await diffNameStatus(dir, "HEAD", remote)) : [];
  const changedFiles = changedPages.map((p) => p.path);
  return {
    teamId,
    role: binding.role,
    state,
    ahead,
    behind,
    dirty,
    changedFiles,
    changedPages,
    ...legacyCredential
  };
}
async function resolveDivergence(deps, teamId, choice, opts = {}) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const dir = clonePath(teamId, deps.dataHome);
  if (!await pathExists2(dir))
    throw new AgentError(`no local clone for "${teamId}" \u2014 run "commonground pull" first`);
  if (choice === "keep-local") {
    return { teamId, choice };
  }
  const draftBranch = await snapshotToDraft(dir, binding, opts.label);
  if (choice === "save-as-draft") {
    return { teamId, choice, draftBranch };
  }
  await refreshRemote(dir, await deps.backend.remoteAccess(teamId));
  await resetHardTo(dir, `origin/${await currentBranch(dir)}`);
  await injectAll(dir);
  return { teamId, choice, draftBranch };
}
async function lint(deps, teamId) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const dir = clonePath(teamId, deps.dataHome);
  if (!await pathExists2(dir))
    throw new AgentError(`no local clone for "${teamId}" \u2014 run "commonground pull" first`);
  return { ...await localLint(dir), clonePath: dir };
}
async function coverage(deps, teamId) {
  const binding = await readBinding(teamId, deps.configHome, deps.dataHome);
  if (!binding)
    throw notLoggedIn(teamId, deps.configHome);
  const dir = clonePath(teamId, deps.dataHome);
  if (!await pathExists2(dir))
    throw new AgentError(`no local clone for "${teamId}" \u2014 run "commonground pull" first`);
  await refreshTeamProfile(deps, teamId, binding.token);
  return {
    ...await localCoverage(dir, await readTeamProfile(teamId, deps.configHome)),
    clonePath: dir
  };
}
function agentAuthor(binding) {
  return { name: binding.userId, email: `${binding.userId}@users.commonground.local` };
}
async function pathExists2(path) {
  try {
    await (0, import_promises5.access)(path);
    return true;
  } catch {
    return false;
  }
}

// ../../apps/sync-agent/dist/cli.js
var USAGE = `commonground \u2014 CommonGround sync agent

Usage:
  commonground login --start   print the authorize URL + code and exit (resumable; pair with --wait)
  commonground login --wait    poll for approval for ~90s; safe to run again if not yet approved
  commonground login [token]   authorize this device \u2014 opens a browser (hosted mode); or pass a
                               device token for CI/manual binding
  commonground init [team]     connect THIS project to the team wiki: write a router block into
                               ./CLAUDE.md (--mode mcp [default] | local; local also clones).
                               --refresh re-renders the block in the wiki's charter voice
  commonground pull [team]     get the team's latest into your local clone (everyone). Never
                               overwrites local work: it stops and reports instead. Add
                               --take-remote to adopt the hosted version anyway (your work is
                               saved on a draft branch first)
  commonground push [team]     publish your local changes (admins/curators) \u2014 commits for you.
                               --dry-run previews without publishing. Stops if the hosted wiki
                               moved (--mine keeps YOUR version of pages both sides changed;
                               never force-pushes), and stops if the change REMOVES pages from
                               the team wiki (--allow-deletes confirms those)
  commonground status [team]   show sync state ("N commits behind") + local divergence.
                               --clear-stale-credential removes a leftover pre-0.4.1 sign-in file
                               from inside your wiki folder \u2014 refused unless that file is provably
                               unused, so it can never sign you out
  commonground lint [team]     health-check YOUR LOCAL COPY (everyone): stale / orphan / broken
                               citation / thin summary, plus pages referenced but not written yet.
                               Reads the working tree, so unpublished edits count. --json for the
                               machine-readable form. Detection only \u2014 it never edits
  commonground coverage [team] what the wiki's own checklist still wants (everyone), against your
                               LOCAL copy: the charter's structure when chartered, else the team
                               shape template. --json for the machine-readable form
  commonground resolve <how>   low-level divergence escape hatch: keep-local | take-remote |
                               save-as-draft
  commonground export [team]   write a static tar of the current wiki (HEAD)
  commonground import <dir> [team]
                               load an existing local wiki folder into the team wiki (admins). The
                               folder is COPIED into your wiki clone and left untouched \u2014 from then
                               on the clone is the copy CommonGround syncs

Your wiki folder lives at ~/CommonGround/<team>/ (override with COMMONGROUND_HOME).
Your sign-in is stored separately at ~/.commonground/credentials.json (override with
COMMONGROUND_CONFIG_HOME) \u2014 moving or deleting your wiki folder never signs you out.
Talks to the hosted API at https://api.commongroundapp.io by default (override with
COMMONGROUND_API_URL). Local/offline mode: set COMMONGROUND_REPOS_DIR (dir of <teamId>.git bare
repos) + optional COMMONGROUND_MEMBERSHIPS.
`;
var DEFAULT_API_URL = "https://api.commongroundapp.io";
function resolveApiBaseUrl() {
  return process.env.COMMONGROUND_API_URL ?? DEFAULT_API_URL;
}
async function buildDeps() {
  const configHome = agentConfigHome();
  const dataHome = agentDataHome();
  const reposDir = process.env.COMMONGROUND_REPOS_DIR;
  if (reposDir && !process.env.COMMONGROUND_API_URL) {
    const membershipsPath = process.env.COMMONGROUND_MEMBERSHIPS;
    const memberships = membershipsPath ? JSON.parse(await (0, import_promises6.readFile)(membershipsPath, "utf8")) : {};
    return { backend: new LocalSyncBackend({ reposDir, memberships }), configHome, dataHome };
  }
  return {
    backend: new HttpSyncBackend({ apiBaseUrl: resolveApiBaseUrl(), configHome, dataHome }),
    configHome,
    dataHome
  };
}
function openBrowser(url) {
  let safe;
  try {
    const parsed = new URL(url);
    if (parsed.protocol !== "http:" && parsed.protocol !== "https:")
      return;
    safe = parsed.toString();
  } catch {
    return;
  }
  const cmd = process.platform === "darwin" ? "open" : process.platform === "win32" ? "start" : "xdg-open";
  try {
    (0, import_node_child_process3.spawn)(cmd, [safe], {
      stdio: "ignore",
      detached: true,
      shell: process.platform === "win32"
    }).unref();
  } catch {
  }
}
async function deviceLogin() {
  return browserLogin({
    apiBaseUrl: resolveApiBaseUrl(),
    configHome: agentConfigHome(),
    dataHome: agentDataHome(),
    sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
    onPrompt: (p) => {
      process.stdout.write(`
Authorize this device in your browser:
  ${p.verificationUriComplete}
  (confirm the code ${p.userCode} if asked)

Waiting for approval\u2026
`);
      openBrowser(p.verificationUriComplete);
    }
  });
}
function deviceLoginDeps(quiet = false) {
  return {
    apiBaseUrl: resolveApiBaseUrl(),
    configHome: agentConfigHome(),
    dataHome: agentDataHome(),
    sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
    onPrompt: (p) => {
      if (quiet)
        return;
      process.stdout.write(`
Authorize this device in your browser:
  ${p.verificationUriComplete}
  (confirm the code ${p.userCode} if asked)
`);
      openBrowser(p.verificationUriComplete);
    }
  };
}
var WAIT_BUDGET_MS = 9e4;
async function resolveTeamId(deps, arg) {
  if (arg)
    return arg;
  const teams = Object.keys((await readStore(deps.configHome, deps.dataHome)).teams);
  if (teams.length === 1)
    return teams[0];
  if (teams.length === 0)
    throw notLoggedIn(void 0, deps.configHome);
  throw new AgentError(`multiple teams logged in \u2014 specify one: ${teams.join(", ")}`);
}
var PAGE_SYMBOL = {
  added: "+",
  modified: "~",
  deleted: "-",
  renamed: "~"
};
function formatReceipt(pages) {
  return pages.map((p) => `${PAGE_SYMBOL[p.kind]} ${p.page}`).join(" \xB7 ");
}
function pageCount(n) {
  return `${n} page${n === 1 ? "" : "s"}`;
}
function parseInitArgs(rest) {
  let mode = "mcp";
  let team;
  let refresh = false;
  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i];
    const modeVal = arg === "--mode" ? rest[++i] : arg.startsWith("--mode=") ? arg.slice(7) : void 0;
    if (arg === "--mode" || arg.startsWith("--mode=")) {
      if (modeVal !== "mcp" && modeVal !== "local") {
        throw new AgentError("usage: commonground init [--mode mcp|local] [--refresh] [team]");
      }
      mode = modeVal;
    } else if (arg === "--refresh") {
      refresh = true;
    } else if (!arg.startsWith("-")) {
      team = arg;
    }
  }
  return { mode, team, refresh };
}
function formatInit(r) {
  const wrote = `Wrote the CommonGround router block into ${r.projectDir}/CLAUDE.md.`;
  return r.mode === "local" ? `Initialized ${r.teamId} (local-clone mode). ${wrote}
Wiki cloned at ${r.clonePath} \u2014 run "commonground pull" to refresh.
` : `Initialized ${r.teamId} (MCP mode). ${wrote}
The wiki is reached via the CommonGround MCP connector \u2014 if it needs auth, run /mcp.
`;
}
function importCaveats(r) {
  const notImported = (r.notImported ?? []).map((s) => `    ${s.relPath} \u2014 ${s.reason}
`).join("");
  const lossy = r.lossy ?? [];
  const dropped = new Set(lossy.flatMap((f) => f.loss.dropped));
  const replaced = new Set(lossy.flatMap((f) => f.loss.replaced.map((s) => s.split(":")[0])));
  return (notImported ? `  Not imported (the wiki owns these):
${notImported}` : "") + (lossy.length ? `  Frontmatter changed on ${pageCount(lossy.length)}` + (dropped.size ? ` \u2014 dropped: ${[...dropped].join(", ")}` : "") + (replaced.size ? `; replaced off-schema: ${[...replaced].join(", ")}` : "") + ` (per-file detail above).
` : "");
}
function importConvergence(r) {
  return `  Your wiki lives at ${r.clonePath} \u2014 that's the copy CommonGround syncs.
  ${r.sourceDir} was left untouched; edits made there won't reach the wiki.
`;
}
function formatImport(r) {
  if (r.nothingToImport)
    return `${r.sourceDir} added nothing new to ${r.teamId} \u2014 nothing was published.
` + importCaveats(r) + importConvergence(r);
  const tail = r.synced?.action === "pushed" ? " Published to the hosted wiki." : r.synced?.action === "local-only" ? " Committed locally (your role is read-only, so nothing was pushed)." : r.synced?.action === "diverged" ? ' NOTE: the hosted wiki diverged \u2014 run "commonground status" to resolve.' : "";
  const normalized = r.normalized ? ` Normalized frontmatter on ${r.normalized} page(s).` : "";
  const skipped = r.skipped ? ` ${r.skipped} file(s) couldn't be normalized (imported as-is).` : "";
  const blocked = r.synced?.action === "blocked-deletes" ? ` Committed locally, NOT published \u2014 the pending changes also REMOVE ${pageCount((r.synced.deletions ?? []).length)} from the team wiki${r.synced.deletions?.length ? ` (${r.synced.deletions.map((p) => p.page).join(", ")})` : ""}.
  Review with "commonground push --dry-run", then publish with:
    commonground push --allow-deletes
` : "";
  return `Imported ${r.imported} file(s) from ${r.sourceDir} into ${r.teamId}.${tail}${normalized}${skipped}
` + blocked + importCaveats(r) + importConvergence(r);
}
function legacyCredentialNote(state, deps) {
  if (!state)
    return "";
  const legacy = legacyStorePath(deps.dataHome);
  switch (state) {
    case "live":
      return `Heads-up: your sign-in is still stored inside your wiki folder (${legacy}) instead of at ${storePath(deps.configHome)}. Until it moves, deleting or moving the wiki folder would sign you out. Run "commonground login" to move it now \u2014 and if it stays put after that, ${deps.configHome} isn't writable, which is the one thing that keeps the move from completing on its own.
`;
    case "redundant":
      return `Note: an old copy of your sign-in is left over at ${legacy}. It is no longer used \u2014 run "commonground status --clear-stale-credential" to remove it.
`;
    case "divergent":
      return `Note: an older sign-in file at ${legacy} holds a credential this machine no longer uses. It is not read, and CommonGround will not delete it for you. Run "commonground login" to consolidate, or remove that file yourself.
`;
    case "unreadable":
      return `Note: ${legacy} exists but can't be read, so CommonGround can't tell whether it still holds a sign-in \u2014 it is left alone rather than removed. If that file is yours, "chmod 600" makes it readable again; otherwise remove it yourself.
`;
    case "unusable":
      return `Note: ${legacy} is not a usable CommonGround sign-in. It is ignored \u2014 run "commonground status --clear-stale-credential" to remove it.
`;
  }
}
function formatStatus(s, deps, mode = null) {
  return formatSyncState(s, mode) + legacyCredentialNote(s.legacyCredential, deps);
}
function formatSyncState(s, mode = null) {
  const who = `${s.teamId} (you: ${s.role})`;
  switch (s.state) {
    case "not-cloned":
      return mode === "mcp" ? `${who}: signed in. This project reads the wiki through the CommonGround connector \u2014 no local clone, by design.
` : `${who}: not cloned \u2014 run "commonground pull".
`;
    case "up-to-date":
      return `${who}: up to date.
`;
    case "behind": {
      const incoming = s.changedPages.length ? ` Incoming: ${formatReceipt(s.changedPages)}.` : "";
      return `${who}: ${s.behind} commit(s) behind \u2014 run "commonground pull".${incoming}
`;
    }
    case "ahead":
      return `${who}: ${s.ahead} local commit(s)${s.dirty ? " + uncommitted edits" : ""} to publish \u2014 run "commonground push".
`;
    case "diverged":
      return `${who}: DIVERGED (${s.ahead} ahead, ${s.behind} behind${s.dirty ? ", uncommitted edits" : ""}).
  Incoming: ${formatReceipt(s.changedPages) || "(none)"}
  Resolve: commonground resolve <keep-local|take-remote|save-as-draft>
`;
  }
}
function formatSync(r) {
  switch (r.action) {
    case "cloned":
      return `Cloned ${r.teamId} \u2192 ${r.clonePath}
`;
    case "up-to-date":
      return `${r.teamId} is up to date${r.ahead ? ` (${r.ahead} local commit(s) to push)` : ""}.
`;
    case "fast-forwarded": {
      const pages = r.pages ?? [];
      return pages.length ? `Updated ${r.teamId} \u2014 pulled ${pageCount(pages.length)}: ${formatReceipt(pages)}
` : `Updated ${r.teamId} (+${r.behind} from hosted).
`;
    }
    case "pushed": {
      const pages = r.pages ?? [];
      return pages.length ? `Pushed ${pageCount(pages.length)} for ${r.teamId}: ${formatReceipt(pages)}
` : `Pushed ${r.ahead} local commit(s) for ${r.teamId} to the hosted repo.
`;
    }
    case "local-only":
      return `${r.teamId}: ${r.ahead} local commit(s) kept as read-only drafts (members can't push).
`;
    case "diverged":
      return `${r.teamId} has diverged (${r.ahead} ahead, ${r.behind} behind) \u2014 run "commonground status" to resolve. Nothing was changed.
`;
    case "blocked-deletes":
      return `${r.teamId}: nothing was published \u2014 the pending changes REMOVE pages from the team wiki.
` + deleteWarning(r.deletions) + `  Review them with "commonground push --dry-run", then confirm with:
    commonground push --allow-deletes
`;
  }
}
function teamArg(rest) {
  return rest.find((a) => !a.startsWith("--"));
}
function formatPull(r) {
  switch (r.action) {
    case "cloned":
      return `Wiki cloned at ${r.clonePath}.
`;
    case "up-to-date":
      return r.ahead > 0 || r.dirty ? `${r.teamId}: already up to date \u2014 you have unpublished changes ("commonground push").
` : `${r.teamId}: already up to date.
`;
    case "fast-forwarded": {
      const pages = r.pages ?? [];
      return pages.length ? `Updated ${r.teamId} \u2014 pulled ${pageCount(pages.length)}: ${formatReceipt(pages)}
` : `Updated ${r.teamId} (+${r.behind} from hosted).
`;
    }
    case "blocked":
      return `${r.teamId}: ${r.behind} incoming change(s), but you have local work that would be overwritten (${r.ahead} unpublished${r.dirty ? " + uncommitted edits" : ""}). Nothing was changed.
  Incoming: ${formatReceipt(r.pages ?? []) || "(none)"}
  Publish yours first: commonground push
  Or take the hosted version (your work is saved first): commonground pull --take-remote
`;
    case "took-remote":
      return `${r.teamId}: adopted the hosted version` + (r.draftBranch ? ` \u2014 your local work is saved on ${r.draftBranch}.
` : ".\n");
  }
}
function deleteWarning(deletions) {
  if (!deletions?.length)
    return "";
  return `  \u26A0 REMOVES ${pageCount(deletions.length)} from the team wiki: ${deletions.map((p) => p.page).join(", ")}
    Everyone loses access to these. Past versions stay in history, but the page goes away.
`;
}
function formatLint(r) {
  const head = `${r.clonePath} \u2014 ${r.pageCount} page(s), lint of your LOCAL copy (unpublished work included).
`;
  const broken = r.unparseable.length ? `  BROKEN (${r.unparseable.length}) \u2014 these files don't parse, so nothing else here sees them:
` + r.unparseable.map((p) => `    ${p}
`).join("") : "";
  if (!r.findings.length && !r.missingLinks.length && !broken)
    return `${head}  No issues found.
`;
  const byKind = /* @__PURE__ */ new Map();
  for (const f of r.findings)
    byKind.set(f.kind, [...byKind.get(f.kind) ?? [], f]);
  const groups = [...byKind.entries()].map(([kind, fs]) => `  ${kind} (${fs.length}):
` + fs.map((f) => `    ${f.pageIds.join(", ")} \u2014 ${f.detail}
`).join("")).join("");
  const red = r.missingLinks.length ? `  referenced but not written yet (${r.missingLinks.length}):
` + r.missingLinks.map((m) => `    ${m.target} \u2014 linked from ${m.fromPageIds.join(", ")}
`).join("") : "";
  return `${head}${broken}${groups}${red}`;
}
function formatCoverage(r) {
  const done = r.rows.filter((s) => s.status === "done").length;
  const counted = r.rows.filter((s) => s.status !== "excluded").length;
  const basis = r.chartered ? "against this wiki's charter" : `against the default "${r.shape}" shape template` + (r.assumed ? ' (no cached team profile \u2014 run "commonground pull" to refresh)' : "");
  const head = `${r.clonePath} \u2014 ${done}/${counted} section(s) complete, ${basis}.
`;
  const open2 = r.rows.filter((s) => s.status === "empty" || s.status === "partial");
  if (!open2.length)
    return `${head}  Nothing outstanding.
`;
  return head + open2.map((s) => `  [${s.status}] ${s.label}${s.have.length ? ` \u2014 has: ${s.have.map((e) => e.pageId).join(", ")}` : ""}
` + (s.prompt ? `      ${s.prompt}
` : "")).join("");
}
function formatPush(r) {
  switch (r.action) {
    case "preview": {
      const pages = r.pages ?? [];
      if (!pages.length)
        return `${r.teamId}: nothing to publish.
`;
      const conflict = r.behind ? `  Heads up: the hosted wiki moved (${r.behind} change(s)): ${formatReceipt(r.incoming ?? []) || "(none)"}
` : "";
      return `${r.teamId}: would publish ${pageCount(pages.length)}: ${formatReceipt(pages)}
` + conflict + deleteWarning(r.deletions) + `  Nothing published yet \u2014 run "commonground push" to confirm.
`;
    }
    case "needs-delete-confirm":
      return `${r.teamId}: this would publish ${pageCount((r.pages ?? []).length)}: ${formatReceipt(r.pages ?? [])}
` + deleteWarning(r.deletions) + // On the --mine path the replay has already happened and the branch now sits on top of the
      // hosted tip, so the retry is a plain --allow-deletes; re-passing --mine would be a no-op.
      (r.draftBranch ? `  Your pre-merge state is saved on ${r.draftBranch}.
` : "") + `  Nothing was published. To go ahead including the removal(s):
    commonground push --allow-deletes
`;
    case "read-only": {
      const pages = r.pages ?? [];
      return `${r.teamId}: your role is read-only \u2014 publishing is admins/curators only.
` + (pages.length ? `  Your work is safe in ${r.clonePath} \u2014 it just isn't shared yet.
  Unpublished here: ${formatReceipt(pages)}
  To get it to the team, file it as a suggestion for a curator to fold in.
` : "");
    }
    case "nothing-to-push":
      return `${r.teamId}: nothing to publish.
`;
    case "pushed": {
      const pages = r.pages ?? [];
      const removed = r.deletions?.length ? `  Removed from the team wiki: ${r.deletions.map((p) => p.page).join(", ")}
` : "";
      return pages.length ? `Published ${pageCount(pages.length)} to ${r.teamId}: ${formatReceipt(pages)}
${removed}` : `Published ${r.ahead} change(s) to ${r.teamId}.
${removed}`;
    }
    case "blocked":
      return `${r.teamId}: the hosted wiki moved since you last pulled (${r.behind} change(s)) \u2014 nothing was published.
  Theirs: ${formatReceipt(r.incoming ?? []) || "(none)"}
  Yours:  ${formatReceipt(r.pages ?? []) || "(none)"}
  Keep YOUR version of any overlapping pages: commonground push --mine
  Take the hosted version instead (yours saved first): commonground pull --take-remote
`;
    case "published-mine": {
      const pages = r.pages ?? [];
      return `Published your version to ${r.teamId}${pages.length ? `: ${formatReceipt(pages)}` : ""}
` + (r.deletions?.length ? `  Removed from the team wiki: ${r.deletions.map((p) => p.page).join(", ")}
` : "") + (r.draftBranch ? `  Your pre-merge state is saved on ${r.draftBranch}.
` : "");
    }
  }
}
async function clearStaleCredential() {
  const legacy = legacyStorePath();
  const state = await legacyCredentialState();
  if (!state) {
    process.stdout.write(`Nothing to clear \u2014 there is no old sign-in file at ${legacy}.
`);
    return;
  }
  if (state !== "redundant" && state !== "unusable") {
    throw new AgentError(state === "live" ? `refusing to remove ${legacy} \u2014 that file IS your sign-in on this machine, so removing it would sign you out. Run "commonground login" to move it instead.` : state === "unreadable" ? `refusing to remove ${legacy} \u2014 CommonGround can't read that file, so it can't prove it isn't your only sign-in. Make it readable ("chmod 600 ${legacy}") and run this again, or remove it yourself.` : `refusing to remove ${legacy} \u2014 CommonGround can't prove that file is unused (it may hold a sign-in ${storePath()} doesn't), so it isn't ours to destroy. Run "commonground login" to consolidate, or remove that file yourself.`);
  }
  try {
    await (0, import_promises6.unlink)(legacy);
  } catch (e) {
    if (e.code !== "ENOENT") {
      throw new AgentError(`couldn't remove ${legacy} (${e.message}) \u2014 fix the permissions on that folder, or remove the file yourself`);
    }
  }
  await (0, import_promises6.rmdir)((0, import_node_path7.dirname)(legacy)).catch(() => void 0);
  process.stdout.write(`Removed ${legacy}.
` + ((0, import_node_fs2.existsSync)(storePath()) ? `  Your sign-in is unaffected \u2014 CommonGround reads it from ${storePath()}.
` : `  It held no sign-in, so nothing changed about how this machine is signed in.
`));
}
async function main(argv) {
  const [cmd, ...rest] = argv;
  switch (cmd) {
    case void 0:
    case "help":
    case "-h":
    case "--help":
      process.stdout.write(USAGE);
      return;
    case "login": {
      if (rest.includes("--start")) {
        const p = await startDeviceLogin(deviceLoginDeps());
        process.stdout.write(`Open ${p.verificationUri} and enter ${p.userCode}.
Then run "commonground login --wait" (the code is valid for about ${Math.round(p.expiresInSec / 60)} minutes).
`);
        return;
      }
      if (rest.includes("--wait")) {
        const result = await waitDeviceLogin(deviceLoginDeps(true), WAIT_BUDGET_MS);
        if (result === "pending") {
          process.stdout.write('Still waiting for approval in the browser. Run "commonground login --wait" again once you have approved it.\n');
          return;
        }
        process.stdout.write(`Logged in to team ${result.teamId} as ${result.role} (user ${result.userId}).
`);
        return;
      }
      const token = rest[0];
      const binding = token ? await login(await buildDeps(), token) : await deviceLogin();
      process.stdout.write(`Logged in to team ${binding.teamId} as ${binding.role} (user ${binding.userId}).
`);
      return;
    }
    case "init": {
      const { mode, team, refresh } = parseInitArgs(rest);
      const deps = await buildDeps();
      let effectiveMode = mode;
      let effectiveTeam = team;
      if (refresh) {
        const detected = await detectRouterBlock(process.cwd());
        if (!detected) {
          throw new AgentError("no CommonGround router block in ./CLAUDE.md \u2014 initialize first: commonground init [--mode mcp|local]");
        }
        effectiveMode = detected.mode;
        if (detected.teamId) {
          if (team && team !== detected.teamId) {
            throw new AgentError(`this project's block is bound to team ${detected.teamId} \u2014 refresh without a team argument, or re-run init --mode ${detected.mode} ${team} to rebind`);
          }
          effectiveTeam = detected.teamId;
        }
      }
      const result = await initProject(deps, {
        mode: effectiveMode,
        teamId: await resolveTeamId(deps, effectiveTeam),
        projectDir: process.cwd()
      });
      process.stdout.write(formatInit(result));
      return;
    }
    case "sync": {
      const deps = await buildDeps();
      const result = await sync(deps, await resolveTeamId(deps, rest[0]));
      process.stdout.write(formatSync(result));
      return;
    }
    case "pull": {
      const deps = await buildDeps();
      const takeRemote = rest.includes("--take-remote");
      const result = await pull(deps, await resolveTeamId(deps, teamArg(rest)), { takeRemote });
      process.stdout.write(formatPull(result));
      return;
    }
    case "push": {
      const deps = await buildDeps();
      const mine = rest.includes("--mine");
      const dryRun = rest.includes("--dry-run");
      const allowDeletes = rest.includes("--allow-deletes");
      const result = await push(deps, await resolveTeamId(deps, teamArg(rest)), {
        mine,
        dryRun,
        allowDeletes
      });
      process.stdout.write(formatPush(result));
      return;
    }
    case "status": {
      if (rest.includes("--clear-stale-credential")) {
        await clearStaleCredential();
        return;
      }
      const deps = await buildDeps();
      const result = await status(deps, await resolveTeamId(deps, teamArg(rest)));
      const project = await detectRouterBlock(process.cwd());
      process.stdout.write(formatStatus(result, deps, project?.mode ?? null));
      return;
    }
    case "resolve": {
      const choice = rest[0];
      if (choice !== "keep-local" && choice !== "take-remote" && choice !== "save-as-draft") {
        throw new AgentError("usage: commonground resolve <keep-local|take-remote|save-as-draft> [team]");
      }
      const deps = await buildDeps();
      const result = await resolveDivergence(deps, await resolveTeamId(deps, rest[1]), choice);
      process.stdout.write(result.draftBranch ? `Resolved ${result.teamId} via ${result.choice}; local work saved on ${result.draftBranch}.
` : `Resolved ${result.teamId} via ${result.choice}.
`);
      return;
    }
    case "lint": {
      const deps = await buildDeps();
      const result = await lint(deps, await resolveTeamId(deps, teamArg(rest)));
      process.stdout.write(rest.includes("--json") ? `${JSON.stringify(result, null, 2)}
` : formatLint(result));
      return;
    }
    case "coverage": {
      const deps = await buildDeps();
      const result = await coverage(deps, await resolveTeamId(deps, teamArg(rest)));
      process.stdout.write(rest.includes("--json") ? `${JSON.stringify(result, null, 2)}
` : formatCoverage(result));
      return;
    }
    case "export": {
      const deps = await buildDeps();
      const { path } = await exportWiki(deps, await resolveTeamId(deps, rest[0]));
      process.stdout.write(`Exported wiki (HEAD) \u2192 ${path}
`);
      return;
    }
    case "import": {
      const folder = rest[0];
      if (!folder || folder.startsWith("-"))
        throw new AgentError("usage: commonground import <dir> [team]");
      const deps = await buildDeps();
      const result = await importWiki(deps, {
        sourceDir: (0, import_node_path7.resolve)(folder),
        teamId: await resolveTeamId(deps, rest[1])
      });
      process.stdout.write(formatImport(result));
      return;
    }
    default:
      process.stderr.write(`commonground: unknown command "${cmd}"

${USAGE}`);
      process.exitCode = 1;
  }
}
main(process.argv.slice(2)).catch((err) => {
  process.stderr.write(`commonground: ${err instanceof Error ? err.message : String(err)}
`);
  process.exit(1);
});
