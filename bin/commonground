// ../core/dist/charter/charter.js
var HEADING_KEYS = {
  audience: "audience",
  structure: "structure",
  "retrieval brief": "brief",
  "pinned keywords": "pinned",
  // The anti-scope (SER-172). Several spellings because this heading is written by a Claude
  // session from a seed prompt, and users rename it — all mean the same section.
  excludes: "excludes",
  exclusions: "excludes",
  "what doesn't belong": "excludes",
  "what does not belong": "excludes",
  "what doesn't belong here": "excludes",
  "out of scope": "excludes"
};
var HEADING_RE = /^(#{1,4})\s+(.+?)\s*:?\s*$/;
var PLACEHOLDER_RE = /^<[^>]*>$/;
var BULLET_RE = /^[-*]\s+(.+)$/;
var SEPARATORS = [" \u2014 ", " \u2013 ", " - ", ": "];
function chunk(body) {
  const chunks = /* @__PURE__ */ new Map();
  let current = null;
  for (const raw of body.split("\n")) {
    const heading = HEADING_RE.exec(raw.trim());
    if (heading) {
      const key = HEADING_KEYS[heading[2].toLowerCase()];
      if (key) {
        current = key;
        if (!chunks.has(key))
          chunks.set(key, []);
        continue;
      }
      if (heading[1].length <= 2) {
        current = null;
        continue;
      }
    }
    if (current)
      chunks.get(current).push(raw);
  }
  return chunks;
}
function parseAudience(lines) {
  if (!lines)
    return null;
  const text = lines.filter((l) => !PLACEHOLDER_RE.test(l.trim())).join(" ").replace(/<[^>]*>/g, " ").toLowerCase().replace(/[\s_]+/g, "-");
  let best = null;
  for (const audience of WIKI_AUDIENCES) {
    const at = text.indexOf(audience);
    if (at !== -1 && (best === null || at < best.at))
      best = { audience, at };
  }
  return best?.audience ?? null;
}
function parseSections(lines) {
  if (!lines)
    return [];
  const sections = [];
  for (const raw of lines) {
    const bullet = BULLET_RE.exec(raw.trim());
    if (!bullet)
      continue;
    const text = bullet[1].replace(/\*\*/g, "").trim();
    if (/<[^>]*>/.test(text))
      continue;
    if (/^[—–:-]/.test(text))
      continue;
    const sep = SEPARATORS.map((s) => ({ s, at: text.indexOf(s) })).filter((x) => x.at !== -1).sort((a, b) => a.at - b.at)[0];
    const label = (sep ? text.slice(0, sep.at) : text).trim();
    const hint = sep ? text.slice(sep.at + sep.s.length).trim() : "";
    if (label)
      sections.push({ label, hint });
  }
  return sections;
}
function parseBrief(lines) {
  if (!lines)
    return null;
  const text = lines.map((l) => l.trim().replace(/^#{1,6}\s+/, "")).filter((l) => l && !PLACEHOLDER_RE.test(l)).join(" ").trim();
  return text || null;
}
function parsePinned(lines) {
  if (!lines)
    return [];
  const seen = /* @__PURE__ */ new Set();
  const pinned = [];
  for (const part of lines.join("\n").split(/[,\n]/)) {
    const term = part.replace(/^[-*]\s+/, "").trim().toLowerCase().replace(/\s+/g, " ");
    if (!term || term.length < 2 || /[<>]/.test(term) || seen.has(term))
      continue;
    seen.add(term);
    pinned.push(term);
  }
  return pinned;
}
function parseCharter(body) {
  const chunks = chunk(typeof body === "string" ? body : "");
  return {
    audience: parseAudience(chunks.get("audience")),
    sections: parseSections(chunks.get("structure")),
    retrievalBrief: parseBrief(chunks.get("brief")),
    pinnedKeywords: parsePinned(chunks.get("pinned")),
    // Same prose shape as the brief (free text, bullets or a sentence), so it reuses that parser.
    excludes: parseBrief(chunks.get("excludes"))
  };
}

