  let adoptable;
  try {
    let followedLink = false;
    let fh;
    try {
      fh = await (0, import_promises.open)(path, import_node_fs.constants.O_RDONLY | O_NOFOLLOW);
    } catch (e) {
      const code = e.code;
      if (code !== "ELOOP" && code !== "EMLINK")
        throw e;
      followedLink = true;
      fh = await (0, import_promises.open)(path, "r");
    }
    try {
      const st = await fh.stat();
      const uid = process.getuid?.();
      adoptable = !followedLink && st.isFile() && (uid === void 0 || st.uid === uid) && isPrivateMode(st.mode);
