// ../../apps/sync-agent/dist/health.js
var import_promises3 = require("node:fs/promises");
var import_node_path4 = require("node:path");

// ../../apps/sync-agent/dist/wiki-paths.js
var RESERVED_ROOT_NAMES = ["CLAUDE.md", WIKI_LAYOUT.indexFile, WIKI_LAYOUT.logFile];
var RESERVED_SEGMENTS = new Set([".git", WIKI_LAYOUT.configDir].map((s) => s.toLowerCase()));
var RESERVED_ROOT_FILES = new Set(RESERVED_ROOT_NAMES.map((f) => f.toLowerCase()));
function foldedSegments(relPath) {
  return relPath.normalize("NFC").split(/[/\\]/).map((s) => s.toLowerCase());
}
function isReservedPath(relPath) {
  const segments = foldedSegments(relPath);
  if (segments.some((s) => RESERVED_SEGMENTS.has(s)))
    return true;
  return segments.length === 1 && RESERVED_ROOT_FILES.has(segments[0]);
}
function isRawSourcePath(relPath) {
  return foldedSegments(relPath)[0] === WIKI_LAYOUT.sourcesDir;
}
function isWikiPagePath(relPath) {
  return !isReservedPath(relPath) && !isRawSourcePath(relPath);
}

// ../../apps/sync-agent/dist/health.js
var STALE_DAYS = 183;
async function walk(root, keep) {
  const out = [];
  async function descend(abs, rel) {
    let entries;
    try {
      entries = await (0, import_promises3.readdir)(abs, { withFileTypes: true });
    } catch {
      return;
    }
    for (const e of entries) {
      const childRel = rel ? `${rel}/${e.name}` : e.name;
      if (e.isDirectory()) {
        if (!RESERVED_SEGMENTS.has(e.name.normalize("NFC").toLowerCase()))
          await descend((0, import_node_path4.join)(abs, e.name), childRel);
      } else if (e.isFile() && keep(childRel)) {
        out.push(childRel);
      }
    }
  }
  await descend(root, "");
  return out;
}
function isPageFile(rel) {
  return rel.endsWith(".md") && isWikiPagePath(rel);
}
async function readWorkingTree(dir) {
  const pages = [];
  const unparseable = [];
  for (const rel of await walk(dir, isPageFile)) {
    let raw;
    try {
      raw = await (0, import_promises3.readFile)((0, import_node_path4.join)(dir, rel), "utf8");
    } catch {
      continue;
    }
    try {
      const parsed = parsePage(raw);
      pages.push({ pageId: pageIdFromPath(rel), frontmatter: parsed.frontmatter, body: parsed.body });
    } catch {
      unparseable.push(rel);
    }
  }
  const sourcePaths = new Set((await walk((0, import_node_path4.join)(dir, WIKI_LAYOUT.sourcesDir), () => true).catch(() => [])).map((rel) => `${WIKI_LAYOUT.sourcesDir}/${rel}`));
  return { pages, sourcePaths, unparseable };
}
async function localLint(dir, now = /* @__PURE__ */ new Date()) {
  const { pages, sourcePaths, unparseable } = await readWorkingTree(dir);
  const resolveBodyLink = buildBodyLinkResolver(pages.map((p) => ({
    pageId: p.pageId,
    title: p.frontmatter.title,
    active: p.frontmatter.status === "active"
  })));
  const inbound = /* @__PURE__ */ new Set();
  const missing = /* @__PURE__ */ new Map();
  for (const p of pages) {
    if (p.frontmatter.status !== "active")
      continue;
    for (const ref of p.frontmatter.related)
      if (ref !== p.pageId)
        inbound.add(ref);
    for (const link2 of extractBodyLinks(p.body)) {
      const resolved = resolveBodyLink(link2.target);
      if (resolved) {
        if (resolved !== p.pageId)
          inbound.add(resolved);
      } else {
        const key = link2.target.toLowerCase();
        const entry = missing.get(key) ?? { target: link2.target, from: /* @__PURE__ */ new Set() };
        entry.from.add(p.pageId);
        missing.set(key, entry);
      }
    }
  }
  const subjects = pages.map((p) => ({
    pageId: p.pageId,
    status: p.frontmatter.status,
    updated: p.frontmatter.updated,
    sources: p.frontmatter.sources,
    related: p.frontmatter.related,
    summary: p.frontmatter.summary,
    derivedSummary: deriveSummary(p.body)
  }));
  return {
    findings: runDeterministicLint({
      subjects,
      existingPageIds: new Set(pages.map((p) => p.pageId)),
      inbound,
      sourcePaths,
      now,
      staleDays: STALE_DAYS
    }),
    // Most-referenced first, then alphabetical — the same ordering the server surfaces.
    missingLinks: [...missing.values()].map((m) => ({ target: m.target, fromPageIds: [...m.from].sort() })).sort((a, b) => b.fromPageIds.length - a.fromPageIds.length || a.target.localeCompare(b.target)),
    unparseable,
    pageCount: pages.length
  };
}
async function localCoverage(dir, profile = {}) {
  const { pages } = await readWorkingTree(dir);
  const entries = pages.map((p) => toIndexEntry({ pageId: p.pageId, frontmatter: p.frontmatter, body: p.body }));
  const charterPage = pages.find((p) => p.pageId === CHARTER_PAGE_ID);
  const charter = charterPage && charterPage.frontmatter.status === "active" ? parseCharter(charterPage.body) : null;
  const shape = profile.shape ?? "company";
  return {
    rows: computeCoverage(entries, shape, profile.teamName ?? "team", charter),
    chartered: Boolean(charter?.sections?.length),
    shape,
    assumed: !profile.shape
  };
}

// ../../apps/sync-agent/dist/injection.js
var import_promises4 = require("node:fs/promises");
