async function snapshotWorkingTree(dir, message, author) {
  const tmpIndex = (0, import_node_path2.join)(dir, ".git", `commonground-snapshot-${process.pid}-${Date.now()}.index`);
  const env = {
    GIT_INDEX_FILE: tmpIndex,
    // merged over process.env by runGit
    GIT_AUTHOR_NAME: author.name,
    GIT_AUTHOR_EMAIL: author.email,
    GIT_COMMITTER_NAME: author.name,
    GIT_COMMITTER_EMAIL: author.email
  };
  try {
    await runGit(dir, ["read-tree", "HEAD"], env);
    await runGit(dir, ["add", "-A"], env);
    const tree = (await runGit(dir, ["write-tree"], env)).trim();
    return (await runGit(dir, ["commit-tree", tree, "-p", "HEAD", "-m", message], env)).trim();
  } finally {
    await (0, import_promises2.rm)(tmpIndex, { force: true }).catch(() => void 0);
  }
}
