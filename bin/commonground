function withoutUserinfo(url) {
  try {
    const parsed = new URL(url);
    if (!parsed.username && !parsed.password)
      return url;
    parsed.username = "";
    parsed.password = "";
    return parsed.toString();
  } catch {
    return url;
  }
}
async function refreshRemote(dir, remote) {
  try {
    const current = (await runGit(dir, ["remote", "get-url", "origin"])).trim();
    if (current !== remote.url && withoutUserinfo(current) === remote.url) {
      await runGit(dir, ["remote", "set-url", "origin", remote.url]);
    }
  } catch {
  }
  await fetchOrigin(dir, remote.env);
}
async function currentBranch(dir) {
  return (await runGit(dir, ["rev-parse", "--abbrev-ref", "HEAD"])).trim();
}
async function isWorkingTreeClean(dir) {
  const out = await runGit(dir, ["status", "--porcelain", "--untracked-files=no"]);
  return out.trim().length === 0;
}
async function aheadBehind(dir, local, remote) {
  const out = (await runGit(dir, ["rev-list", "--left-right", "--count", `${local}...${remote}`])).trim();
  const [ahead, behind] = out.split(/\s+/).map((n) => Number.parseInt(n, 10));
  return { ahead: ahead || 0, behind: behind || 0 };
}
