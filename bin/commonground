  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    parsed = void 0;
  }
  const teams = parsed?.teams;
  if (!teams || typeof teams !== "object") {
    throw new StoreFileError(`your CommonGround sign-in at ${path} is corrupt \u2014 fix or delete that file, then run "commonground login"`, "corrupt");
  }
  return { store: parsed, raw, adoptable };
}
async function writeStoreFile(path, raw, opts = {}) {
  const dir = (0, import_node_path.dirname)(path);
  await (0, import_promises.mkdir)(dir, { recursive: true, mode: 448 });
  await (0, import_promises.chmod)(dir, 448);
  const tmp = `${path}.${(0, import_node_crypto.randomUUID)()}.tmp`;
  let published = false;
  try {
    const fh = await (0, import_promises.open)(tmp, "wx", 384);
    try {
      await fh.writeFile(raw);
      await fh.chmod(384);
      await fh.sync();
    } finally {
      await fh.close();
    }
    if (opts.exclusive) {
      try {
        await (0, import_promises.link)(tmp, path);
        published = true;
      } catch (e) {
        if (e.code !== "EEXIST")
          throw e;
      }
    } else {
      await (0, import_promises.rename)(tmp, path);
      published = true;
    }
    if (published)
      await fsyncDir(dir).catch(() => void 0);
  } finally {
    await (0, import_promises.rm)(tmp, { force: true }).catch(() => void 0);
  }
  return published;
}
function sameBinding(a, b) {
  return !!a && !!b && a.token === b.token && a.userId === b.userId && a.teamId === b.teamId && a.role === b.role;
}
function coveredBy(subset, live) {
  return Object.entries(subset.teams).every(([teamId, binding]) => sameBinding(live.teams[teamId], binding));
}
async function removeLegacyStore(legacyPath) {
  await (0, import_promises.unlink)(legacyPath).catch(() => void 0);
  await (0, import_promises.rmdir)((0, import_node_path.dirname)(legacyPath)).catch(() => void 0);
}
async function relocateLegacyStore(configHome, dataHome, legacyPath, legacy) {
  if (!legacy.adoptable)
    return;
  const dest = storePath(configHome);
  if (isInside(dataHome, dest))
    return;
  if (!await writeStoreFile(dest, legacy.raw, { exclusive: true }))
    return;
  await removeLegacyStore(legacyPath);
}
async function sweepLegacyStore(legacyPath, live) {
  const legacy = await readStoreFile(legacyPath);
  if (!legacy || !legacy.adoptable)
    return;
  if (!coveredBy(legacy.store, live))
    return;
  await removeLegacyStore(legacyPath);
}
async function readStore(configHome = agentConfigHome(), dataHome = agentDataHome()) {
  const legacyPath = legacyStorePath(dataHome);
  const current = await readStoreFile(storePath(configHome));
  if (current) {
    await sweepLegacyStore(legacyPath, current.store).catch(() => void 0);
    return current.store;
  }
  const legacy = await readStoreFile(legacyPath);
  if (!legacy) {
    return (await readStoreFile(storePath(configHome)))?.store ?? { teams: {} };
  }
  await relocateLegacyStore(configHome, dataHome, legacyPath, legacy).catch(() => void 0);
  return legacy.store;
}
async function readBinding(teamId, configHome = agentConfigHome(), dataHome = agentDataHome()) {
  return (await readStore(configHome, dataHome)).teams[teamId] ?? null;
}
async function writeBinding(binding, configHome = agentConfigHome(), dataHome = agentDataHome()) {
  const legacyPath = legacyStorePath(dataHome);
  const store = await readStore(configHome, dataHome);
  const legacy = await readStoreFile(legacyPath).catch(() => null);
  const consolidatable = !!legacy?.adoptable;
  if (legacy && consolidatable) {
    for (const [teamId, held] of Object.entries(legacy.store.teams))
      store.teams[teamId] ??= held;
  }
  store.teams[binding.teamId] = binding;
  await writeStoreFile(storePath(configHome), `${JSON.stringify(store, null, 2)}
`);
  if (legacy && consolidatable && coveredBy(legacy.store, store)) {
    await removeLegacyStore(legacyPath);
  }
}
async function legacyCredentialState(configHome = agentConfigHome(), dataHome = agentDataHome()) {
  let legacy;
  try {
    legacy = await readStoreFile(legacyStorePath(dataHome));
  } catch (e) {
    return e instanceof StoreFileError && e.fault === "corrupt" ? "unusable" : "unreadable";
  }
  if (!legacy)
    return null;
  const live = await readStoreFile(storePath(configHome)).catch(() => null);
  if (!live)
    return "live";
  return legacy.adoptable && coveredBy(legacy.store, live.store) ? "redundant" : "divergent";
}
function notLoggedIn(teamId, configHome) {
  const home = configHome ?? agentConfigHome();
  const at = ` (no credentials at ${storePath(home)})`;
  const elsewhere = envDir("COMMONGROUND_CONFIG_HOME", "") && (0, import_node_path.resolve)(home) !== (0, import_node_path.resolve)(defaultConfigHome()) && (0, import_node_fs.existsSync)(storePath(defaultConfigHome())) ? ` (a sign-in also exists at ${storePath(defaultConfigHome())}, but COMMONGROUND_CONFIG_HOME points at ${home})` : "";
  return teamId ? new AgentError(`not logged in for team "${teamId}" \u2014 run "commonground login"${at}${elsewhere}`) : new AgentError(`no team logged in \u2014 run "commonground login" first${at}${elsewhere}`);
}

