// ../shared/dist/wiki/scope.js
var KEYED_LEVELS = /* @__PURE__ */ new Set(["department", "team", "product"]);
function parseScope(input) {
  const idx = input.indexOf(":");
  const level = idx === -1 ? input : input.slice(0, idx);
  const key = idx === -1 ? void 0 : input.slice(idx + 1);
  if (!SCOPE_LEVELS.includes(level))
    return null;
  if (KEYED_LEVELS.has(level)) {
    return key ? { level, key } : null;
  }
  return key === void 0 ? { level } : null;
}
function scopeSlug(text) {
  return (text || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40) || "main";
}
function shapeDefaultScope(shape, teamSlugOrName) {
  const key = scopeSlug(teamSlugOrName);
  switch (shape) {
    case "product":
      return `product:${key}`;
    case "team":
      return `team:${key}`;
    case "solo":
    case "company":
    default:
      return "company";
  }
}

// ../shared/dist/wiki/frontmatter.js
var DateString = external_exports.string().regex(/^\d{4}-\d{2}-\d{2}$/, "must be YYYY-MM-DD").refine((s) => {
  const [y, m, d] = s.split("-").map(Number);
  if (y === void 0 || m === void 0 || d === void 0)
    return false;
  const dt = new Date(Date.UTC(y, m - 1, d));
  return dt.getUTCFullYear() === y && dt.getUTCMonth() === m - 1 && dt.getUTCDate() === d;
}, "must be a real calendar date");
var FrontmatterSchema = external_exports.object({
  title: external_exports.string().min(1, "title is required"),
  // Capped generously above the ≤140-char contract the maintainer skill states: the cap is a
  // payload guard (every entry ships in every `get_index`), not a style rule to fail writes on.
  summary: external_exports.string().trim().max(200, "summary must be 200 characters or fewer").optional(),
  type: external_exports.enum(PAGE_TYPES),
  scope: external_exports.string().refine((s) => parseScope(s) !== null, "invalid scope"),
  section: external_exports.enum(SCOPE_SECTIONS).optional(),
  owner: external_exports.string().optional(),
  status: external_exports.enum(PAGE_STATUSES).default("active"),
  created: DateString.optional(),
  updated: DateString,
  aliases: external_exports.array(external_exports.string()).optional(),
  tags: external_exports.array(external_exports.string()).optional(),
  sources: external_exports.array(external_exports.string()).default([]),
  related: external_exports.array(external_exports.string()).default([]),
  extra: external_exports.record(external_exports.unknown()).optional()
}).strict();
var FRONTMATTER_KEYS = Object.keys(FrontmatterSchema.shape);
function foldKey(key) {
  return key.normalize("NFC").toLowerCase().replace(/[^a-z0-9]/g, "");
}
var FOLDED_KEYS = new Map(FRONTMATTER_KEYS.map((k) => [foldKey(k), k]));
function classifyFrontmatterKey(key) {
  const canonical = FOLDED_KEYS.get(foldKey(key));
  if (canonical === void 0)
    return "foreign";
  return canonical === key ? "canonical" : "near-miss";
}
function isRecord(v) {
  return typeof v === "object" && v !== null && !Array.isArray(v);
}
var UNSAFE_KEYS = /* @__PURE__ */ new Set(["__proto__", "constructor", "prototype"]);
function ownEntries(bag) {
  return Object.keys(bag).filter((k) => Object.prototype.hasOwnProperty.call(bag, k)).map((k) => [k, bag[k]]);
}
function partition(input) {
  if (input.extra != null && !isRecord(input.extra))
    return { ok: false, errors: ["extra: must be a map of key \u2192 value"] };
  const canonical = /* @__PURE__ */ Object.create(null);
  const extra = /* @__PURE__ */ Object.create(null);
  const errors = [];
  for (const [key, value] of ownEntries(input)) {
    if (key === "extra")
      continue;
    if (UNSAFE_KEYS.has(key))
      errors.push(`${key}: unsupported key name`);
    else {
      const kind = classifyFrontmatterKey(key);
      if (kind === "canonical")
        canonical[key] = value;
      else if (kind === "near-miss")
        errors.push(`${key}: unrecognized key \u2014 did you mean "${FOLDED_KEYS.get(foldKey(key))}"?`);
      else
        extra[key] = value;
    }
  }
  for (const [key, value] of isRecord(input.extra) ? ownEntries(input.extra) : []) {
    if (UNSAFE_KEYS.has(key))
      errors.push(`extra.${key}: unsupported key name`);
    else {
      const kind = classifyFrontmatterKey(key);
      if (kind === "canonical")
        errors.push(`extra.${key}: "${key}" is a contract key \u2014 set it at the top level`);
      else if (kind === "near-miss")
        errors.push(`extra.${key}: unrecognized key \u2014 did you mean "${FOLDED_KEYS.get(foldKey(key))}"?`);
      else
        extra[key] = value;
    }
  }
  if (errors.length > 0)
    return { ok: false, errors };
  if (Object.keys(extra).length > 0)
    canonical.extra = extra;
  return { ok: true, value: canonical };
}
function validateFrontmatter(input) {
  let candidate = input;
  if (isRecord(input)) {
    const partitioned = partition(input);
    if (!partitioned.ok)
      return { ok: false, errors: partitioned.errors };
    candidate = partitioned.value;
  }
  const result = FrontmatterSchema.safeParse(candidate);
  if (result.success)
    return { ok: true, value: result.data };
  const errors = result.error.issues.map((issue) => {
    const path = issue.path.join(".");
    return path ? `${path}: ${issue.message}` : issue.message;
  });
  return { ok: false, errors };
}

// ../shared/dist/wiki/index-log.js
function buildIndexLine(entry) {
  const link2 = `- [[${entry.pageId}|${entry.title}]]`;
  return entry.summary ? `${link2} \u2014 ${entry.summary}` : link2;
}
function buildLogLine(entry) {
  return `## [${entry.date}] ${entry.op} | ${entry.title}`;
}

